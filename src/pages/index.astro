	.tl-row-desc {
		font-size: 0.8125rem;
		line-height: 1.5;
		color: var(--slate-dim);
		text-wrap: pretty;
	}

	.tl-row-thumb {
		width: 104px;
		height: 66px;
		object-fit: cover;
		border-radius: 6px;
		border: 1px solid var(--card-border);
		background: var(--panel);
	}

	/* At the narrowest sizes the thumb drops below the text instead of shrinking */
	@media (max-width: 419px) {
		.tl-row {
			grid-template-columns: auto 1fr;
		}
		.tl-row-thumb {
			grid-column: 2;
			width: 100%;
			height: 96px;
		}
	}

	/* Below 768px the horizontal strip is replaced by the ledger rows. */
	.tl-viewport {
		display: none;
	}

	@media (min-width: 768px) {
		.tl-viewport {
			display: block;
		}
		.tl-ledger-wrap {
			display: none;
		}
		.section-timeline {
			padding-bottom: clamp(2rem, 4vw, 3rem);
		}
	}

	/* ============================================ */
	/* Tools — counter-scrolling marquees             */

	/* The marquee rows need room on both sides of them: this is the seam
	   between the timeline and Things I've Built, and both neighbours are dense. */
	.section-tools {
		padding-block: clamp(3.5rem, 8vw, 10rem);
	}

	.tools-marquees {
		display: flex;
		flex-direction: column;
		gap: 0.875rem;
	}

	.tools-marquee {
		--scrolling-content-gap: 0.875rem;
		display: block;
	}

	/* Fixed width so the marquee measures a stable item and the tiles keep a
	   square-ish face at every breakpoint. */
	.tool-tile {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		width: 108px;
		height: 108px;
		padding: 0.5rem;
		border-radius: 12px;
		background: rgba(251, 248, 238, 0.05);
		transition: background-color 0.25s ease;
	}

	.tool-tile:hover {
		background: rgba(251, 248, 238, 0.08);
	}

	.tool-mark {
		width: 26px;
		height: 26px;
		color: var(--cream);
		opacity: 0.8;
		transition: opacity 0.25s ease;
	}

	.tool-tile:hover .tool-mark {
		opacity: 1;
	}

	/* The three brands simple-icons has no mark for. A slightly larger label
	   stands in for the logo, with the caption below suppressed so the name is
	   not printed twice. */
	.tool-wordmark {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		letter-spacing: 0.01em;
		color: var(--cream);
		opacity: 0.8;
		text-align: center;
		transition: opacity 0.25s ease;
	}

	.tool-tile:hover .tool-wordmark {
		opacity: 1;
	}

	.tool-tile-text .tool-label {
		display: none;
	}

	.tool-label {
		font-size: 0.6875rem;
		line-height: 1.2;
		text-align: center;
		color: var(--slate-dim);
	}

	@media (max-width: 599px) {
		.tool-tile {
			width: 92px;
			height: 92px;
		}

		.tools-marquee {
			--scrolling-content-fade: 3rem;
		}
	}

	/* Things I've built — five feature rows          */
	/* ============================================ */

	/* The constellation field bleeds sideways out of its row; clip (not hidden,
	   which would make this a scroll container) keeps that bleed from ever
	   widening the page. */
	.section-projects {
		overflow-x: clip;
	}

	.proj-rows {
		display: flex;
		flex-direction: column;
	}

	.proj-row {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;
		align-items: center;
		padding-block: clamp(3rem, 6vw, 5rem);
		border-top: 1px solid var(--hairline);

		/* Reveal tuning, scoped to these rows. The package's own stylesheet is
		   imported after app.css and re-declares these on :root, so the global
		   defaults there never reach the element — setting them here puts the
		   value where nothing outranks it. data-reveal-group="projects:110"
		   staggers each wave of arriving rows. Reduced motion is handled by the
		   package's own media query, which cancels transform and transition. */
		--reveal-duration: 0.72s;
		--reveal-distance: 34px;
	}

	.proj-row:first-child {
		border-top: 0;
		padding-top: 0;
	}

	@media (min-width: 900px) {
		.proj-row {
			grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
			gap: clamp(2.5rem, 5vw, 4.5rem);
		}
		/* Alternate copy-left / demo-left down the column */
		.proj-row:nth-child(even) .proj-copy {
			order: 2;
		}
		/* Cap the copy block and centre it in its column so the row reads
		   balanced against the filled demo panel instead of hugging the inner
		   edge. Auto margins are symmetric, so it works either way round.
		   The text itself stays left-aligned inside the block. */
		.proj-copy {
			max-width: 46ch;
			margin-inline: auto;
		}
	}

	.proj-copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.875rem;
		min-width: 0;
	}

	.proj-pill {
		display: inline-block;
		border: 1px solid var(--gold-faint);
		border-radius: 999px;
		padding: 0.4375rem 0.875rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--gold);
		transition:
			border-color 0.2s ease,
			color 0.2s ease;
	}

	.proj-pill:hover {
		border-color: var(--gold);
		color: var(--gold-bright);
	}

	.proj-title {
		font-size: clamp(1.75rem, 3.6vw, 2.5rem);
		color: var(--cream);
	}

	/* Product names keep their display casing; only the bloom is added. The
	   block keeps the heading wrapping as it did before the split. */
	.proj-title split-text {
		display: block;
	}

	.proj-title :global(.split-text-char) {
		padding-bottom: 0.06em;
	}

	.proj-tagline {
		font-size: clamp(1.0625rem, 2vw, 1.1875rem);
		font-weight: 600;
		color: var(--cream);
		text-wrap: balance;
	}

	.proj-desc {
		font-size: 0.9375rem;
		line-height: 1.65;
		color: var(--slate-dim);
		text-wrap: pretty;
		max-width: 46ch;
	}

	.proj-desc code {
		font-family: var(--font-mono);
		font-size: 0.875em;
		color: var(--slate);
	}

	.proj-install {
		margin-top: 0.375rem;
		border: 1px solid var(--card-border);
		border-radius: 10px;
		background: var(--panel);
		padding: 0.75rem 1.125rem;
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--cream);
		max-width: 100%;
		overflow-x: auto;
		white-space: nowrap;
	}

	.proj-install .dollar {
		color: var(--gold);
		margin-right: 0.375rem;
	}

	/* Spec list: a gold star marker per line, carrying the numbers the
	   description used to state inline. */
	.proj-specs {
		list-style: none;
		margin: 0.125rem 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.4375rem;
	}

	.proj-spec {
		display: flex;
		align-items: center;
		gap: 0.5625rem;
		font-size: 0.875rem;
		color: var(--cream);
	}

	.proj-spec-mark {
		flex: none;
		width: 12px;
		height: 12px;
	}

	/* Outlined pill link, sized down to sit in the copy column's rhythm rather
	   than compete with the hero's actions. */
	.proj-demo-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		align-self: flex-start;
		margin-top: 0.125rem;
		border: 1px solid rgba(251, 248, 238, 0.25);
		border-radius: 999px;
		padding: 0.5625rem 1.125rem;
		font-size: 0.8125rem;
		font-weight: 500;
		color: var(--cream);
		transition:
			border-color 0.25s ease,
			color 0.25s ease;
	}

	.proj-demo-link:hover {
		border-color: var(--gold);
		color: var(--gold-bright);
	}

	.proj-note {
		margin-top: 0.375rem;
		font-size: 0.8125rem;
		color: var(--slate-dim);
	}

	/* Demo panels ------------------------------------------------ */

	.proj-demo {
		border: 1px solid var(--card-border);
		border-radius: var(--radius-card);
		background: var(--card-bg);
		padding: 1.75rem;
		min-height: 300px;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		min-width: 0;
	}

	/* No panel chrome at all: the carousel breaks out and fills the demo side
	   of the row. The slides' own shadows give them definition against the
	   night ground, so a border and a background would only box them in.
	   padding-bottom reserves the strip the pagination is lifted into. */
	.proj-demo-tarot {
		position: relative;
		display: block;
		border: 0;
		background: none;
		/* Top padding gives the card shadows headroom; the bottom strip is
		   where the scrollbar is lifted to. Deep enough to clear the plugin's
		   44px coarse-pointer touch target at its lowered position. */
		padding: 0.75rem 0 3.5rem;
		min-height: 0;
		/* The carousel's own clipping is off below so the shadows survive, which
		   leaves its off-screen slides free to widen the page. This is the box
		   that catches them — the visible slides sit ~80px inside it, so their
		   shadows are never touched. */
		overflow: hidden;
	}

	/* The scrollbar plugin replaces the pagination dots. It is lifted out of
	   flow so tarot-carousel's box collapses to exactly the viewport's slide
	   area — that is what makes the buttons below centre on the slides rather
	   than on the slides-plus-scrollbar stack. Centred on a point just under
	   the carousel, so a coarse-pointer track (which the plugin grows to a
	   44px touch target) stays centred on the same rail. */
	.proj-demo-tarot :global(.tarot-scrollbar) {
		/* Night-palette theming for the plugin's own custom properties. They are
		   declared on :root upstream, so redeclaring them here wins for this
		   carousel and takes the prefers-color-scheme branch out of play. */
		--tarot-scrollbar-height: 6px;
		--tarot-scrollbar-bg: rgba(251, 248, 238, 0.12);
		--tarot-scrollbar-thumb-bg: var(--gold);
		--tarot-scrollbar-thumb-hover-bg: var(--gold-bright);
		--tarot-scrollbar-thumb-active-bg: var(--gold-bright);
		--tarot-scrollbar-border-radius: 999px;
		--tarot-scrollbar-margin: 0;

		position: absolute;
		/* Sits clear of the card shadows rather than tight under the slides. */
		top: calc(100% + 28px);
		left: 50%;
		transform: translate(-50%, -50%);
		width: min(300px, 72%);
	}

	/* The plugin sizes the thumb to the full track height, which on coarse
	   pointers is the 44px touch target rather than the visible rail. Pin it to
	   the rail's height and centre it so the thumb reads as a slim pill on
	   every pointer type. */
	.proj-demo-tarot :global(.tarot-scrollbar-thumb),
	.proj-demo-tarot :global(.tarot-scrollbar-ghost) {
		top: 50%;
		height: var(--tarot-scrollbar-height);
		transform: translateY(-50%);
	}

	/* The carousel's own chrome clips at the viewport edge, which would cut the
	   card shadows off. The slides sit well inside the panel and .proj-demo
	   still clips at its rounded border, so letting these overflow is safe. */
	.proj-demo-tarot tarot-carousel,
	.proj-demo-tarot tarot-viewport {
		overflow: visible;
	}

	/* Peacock animates the slide element's own width, so the slide is the
	   visible card — it carries the corners and the shadow — while the fixed
	   geometry lives on the inner wrapper it reveals. */
	.proj-demo-tarot tarot-slide.tarot-mini-slide {
		display: block;
		border-radius: var(--radius-media);
		overflow: hidden;
		/* Two layers: a soft ambient throw plus a tight contact shadow, so the
		   card still separates from the night ground. */
		box-shadow:
			0 24px 48px -12px rgba(0, 0, 0, 0.55),
			0 4px 12px rgba(0, 0, 0, 0.4);
	}

	/* The card is a brand lockup (920x500): the frame matches that aspect and
	   the image is contained, never cropped — a logo card that loses its edges
	   looks broken. .w-tarot-slide holds the width; this centres it so the
	   slide can open and close around a card that never moves or resizes. */
	.proj-demo-tarot .tarot-mini-inner {
		position: relative;
		left: 50%;
		transform: translateX(-50%);
		aspect-ratio: 920 / 500;
		overflow: hidden;
		background: var(--panel);
	}

	/* Prev/next: circular icon buttons that ride over the slide area, hidden
	   until the carousel is hovered. The package builds these at runtime, so
	   they carry no scope attribute — hence :global(). */
	.proj-demo-tarot :global(.tarot-button) {
		/* Anchored to the viewport's slide area: tarot-carousel is the
		   positioning context and, with the scrollbar lifted out of flow above,
		   its box is exactly tarot-viewport's box — so 50% is the slides' centre
		   line and the scrollbar below is excluded from the maths. */
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		z-index: 2;
		width: 44px;
		height: 44px;
		padding: 0;
		display: none;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		border: 1px solid var(--hairline-strong);
		background: rgba(2, 6, 15, 0.72);
		backdrop-filter: blur(6px);
		color: var(--cream);
		opacity: 0;
		transition:
			opacity 0.25s ease,
			border-color 0.2s ease,
			color 0.2s ease;
	}

	/* Symmetric inset from the viewport's own edges. */
	.proj-demo-tarot :global(.tarot-previous) {
		left: 12px;
	}

	.proj-demo-tarot :global(.tarot-next) {
		right: 12px;
	}

	.proj-demo-tarot :global(.tarot-button svg) {
		width: 22px;
		height: 22px;
	}

	.proj-demo-tarot :global(.tarot-button:hover) {
		border-color: var(--gold);
		color: var(--gold-bright);
	}

	/* Pointer devices only — a touch screen has no hover to reveal them, so it
	   stays on the scrollbar. Keyboard focus reveals them too, so they are never
	   reachable-but-invisible. */
	@media (hover: hover) and (min-width: 900px) {
		.proj-demo-tarot :global(.tarot-button) {
			display: flex;
		}

		.proj-demo-tarot:hover :global(.tarot-button),
		.proj-demo-tarot :global(.tarot-button:focus-visible) {
			opacity: 1;
		}
	}

	/* Everything but the fully-in-view card sits behind a soft blur, so the
	   fan reads as depth rather than five competing logos. Gated on
	   tarot-carousel:defined: if the component never upgrades, the slides stay
	   sharp instead of permanently blurred. The blur lives on the inner
	   wrapper, so the slide's overflow clips it to the rounded corners and the
	   slide's own box-shadow is left alone. */
	.proj-demo-tarot tarot-carousel:defined :global(tarot-slide.tarot-mini-slide .tarot-mini-inner) {
		/* Soft focus, not frosted glass: enough to push the flanking cards back
		   without making their logos unreadable. */
		filter: blur(2.5px);
		transition: filter 0.45s ease;
	}

	.proj-demo-tarot
		tarot-carousel:defined
		:global(tarot-slide.tarot-mini-slide.tarot-fully-visible .tarot-mini-inner) {
		filter: none;
	}

	/* tarot.min.css's peacock rule pushes slide images around with
	   position/left/transform and crops them with object-fit: cover — the
	   inner wrapper already handles placement, so undo all of that here. */
	.proj-demo-tarot .tarot-mini-inner img {
		position: static;
		left: auto;
		transform: none;
		width: 100%;
		max-width: 100%;
		height: 100%;
		object-fit: contain;
		display: block;
	}

	/* Morph engine — cards that fly open into a dialog ------------- */

	/* The panel is unboxed like the tarot one: the cards carry their own
	   surfaces, so a frame around them would only double the chrome. */
	/* .proj-demo centres its children in a row; this one stacks so the margin
	   note sits above the stage rather than beside it. */
	.proj-demo-morph {
		border: 0;
		background: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		align-items: stretch;
		/* .proj-demo clips its panel; that cut the card off mid-morph as it flew
		   toward the dialog. The blob and the dialog are both position: fixed, so
		   nothing here needs clipping to stay in bounds. */
		overflow: visible;
	}

	/* Reads as something scribbled in the margin: off-axis, gold, and gone for
	   good once the reader has taken the hint. */
	/* Label, arrow and card top read as one gesture: the label sits above the
	   stage, the arrow starts at the end of the words and curves down-and-right
	   so its tip lands inside the first card rather than in the gutter. Layered
	   over the grid and click-through, so it never intercepts a card. */
	.morph-hint {
		position: absolute;
		left: 0.5rem;
		top: -34px;
		z-index: 2;
		display: flex;
		align-items: flex-start;
		gap: 0.125rem;
		width: fit-content;
		margin: 0;
		color: var(--gold);
		pointer-events: none;
		transition: opacity 0.4s ease;
	}

	.morph-hint[data-used] {
		opacity: 0;
		pointer-events: none;
	}

	.morph-hint-text {
		font-family: var(--font-body);
		font-size: 0.8125rem;
		line-height: 1.2;
		transform: rotate(-2deg);
	}

	.morph-hint-arrow {
		width: 56px;
		height: 72px;
		flex: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.morph-hint {
			transition: none;
		}
	}

	/* Fixed height so the dialog's measured rect is the same whichever card
	   opened it, and so the row doesn't reflow when the grid goes inert. */
	.morph-stage {
		position: relative;
		height: 320px;
	}

	.morph-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		grid-template-rows: repeat(2, 1fr);
		gap: 0.875rem;
		height: 100%;
	}

	/* Opaque background and a real border: the engine lerps background-color,
	   border and radius, so both ends need something concrete to interpolate.
	   Only colours transition — never opacity or transform, which the engine
	   owns during the flight. */
	.morph-card {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.25rem;
		padding: 0 1.25rem;
		text-align: left;
		cursor: pointer;
		border: 1px solid var(--card-border);
		border-radius: 12px;
		background-color: var(--panel);
		font-family: inherit;
		transition:
			border-color 0.25s ease,
			background-color 0.25s ease;
	}

	.morph-card:hover {
		border-color: var(--gold-faint);
		background-color: #0a1220;
	}

	.morph-card:focus-visible {
		outline: 2px solid var(--gold);
		outline-offset: 2px;
	}

	.morph-card-name {
		font-family: var(--font-mono);
		font-size: 0.9375rem;
		color: var(--cream);
	}

	.morph-card-meta {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.04em;
		color: var(--slate-dim);
	}

	/* One scrim for both phases of the flight. Opacity is fine here — this is
	   not a morph element, so the engine never touches it. */
	.morph-scrim {
		position: fixed;
		inset: 0;
		z-index: 940;
		background: rgba(2, 6, 15, 0.72);
		backdrop-filter: blur(2px);
		opacity: 0;
		visibility: hidden;
		transition:
			opacity 0.3s ease,
			visibility 0.3s ease;
	}

	.morph-scrim[visible] {
		opacity: 1;
		visibility: visible;
	}

	/* Closed, the UA keeps this display:none; the engine flips display on to
	   measure and drives it through the flight, then showModal() promotes it at
	   the reveal point. inset/margin centring rather than a transform, because
	   the engine owns transform. max-width/height none keeps the in-flow and
	   :modal geometry identical. */
	.morph-dialog {
		position: fixed;
		inset: 0;
		margin: auto;
		z-index: 950;
		flex-direction: column;
		width: min(420px, calc(100vw - 3rem));
		height: min(380px, calc(100vh - 6rem));
		max-width: none;
		max-height: none;
		padding: 1.5rem 1.625rem 1.375rem;
		border: 1px solid var(--gold-faint);
		border-radius: 16px;
		background-color: #060d18;
		color: var(--cream);
		box-shadow: 0 30px 90px rgba(0, 0, 0, 0.7);
	}

	.morph-dialog[open] {
		display: flex;
	}

	/* The page scrim owns the dimming, so the UA backdrop stays out of it. */
	.morph-dialog::backdrop {
		background: transparent;
	}

	.morph-dialog-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
	}

	.morph-dialog-tag {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--gold);
		border: 1px solid var(--gold-faint);
		border-radius: 999px;
		padding: 0.25rem 0.625rem;
	}

	.morph-dialog-close {
		border: 1px solid var(--hairline-strong);
		border-radius: 999px;
		background: transparent;
		color: var(--cream);
		font-family: var(--font-body);
		font-size: 0.75rem;
		padding: 0.3125rem 0.75rem;
		cursor: pointer;
		transition:
			border-color 0.2s ease,
			color 0.2s ease;
	}

	.morph-dialog-close:hover {
		border-color: var(--gold);
		color: var(--gold-bright);
	}

	.morph-dialog-title {
		margin-top: 1.125rem;
		font-family: var(--font-display);
		font-size: 1.75rem;
		color: var(--cream);
	}

	.morph-dialog-tagline {
		margin-top: 0.375rem;
		font-size: 0.9375rem;
		font-weight: 600;
		color: var(--cream);
	}

	.morph-dialog-body {
		margin-top: 0.625rem;
		font-size: 0.875rem;
		line-height: 1.65;
		color: var(--slate-dim);
	}

	.morph-dialog-install {
		margin-top: auto;
