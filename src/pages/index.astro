	/* ============================================ */
	/* Timeline — desktop scrubbed strip             */
	/* ============================================ */

	.tl-scroll {
		position: relative;
	}

	.tl-pin {
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.tl-viewport {
		width: 100%;
		overflow-x: auto;
		overflow-y: hidden;
		scroll-snap-type: x mandatory;
		scrollbar-width: thin;
		scrollbar-color: var(--hairline-strong) transparent;
		padding-bottom: 1rem;
	}

	.tl-strip {
		/* One source of truth for the strip's vertical metrics, so the gold
		   hairline lands on the exact centre of the star nodes. */
		--tl-media-h: 190px;
		--tl-stack-gap: 0.75rem;
		--tl-node-size: 18px;
		--tl-node-margin: 2px;

		position: relative;
		display: flex;
		gap: 3rem;
		width: max-content;
		padding-inline: 2px;
	}

	.tl-rule {
		position: absolute;
		/* media + stack gap + node's top margin + half the node = node centre.
		   translateY(-50%) then centres the rule's own thickness on that line,
		   so it stays exact whatever the rule's height is. */
		top: calc(
			var(--tl-media-h) + var(--tl-stack-gap) + var(--tl-node-margin) + var(--tl-node-size) / 2
		);
		transform: translateY(-50%);
		left: 0;
		right: 0;
		height: 1px;
		background: linear-gradient(
			90deg,
			rgba(201, 168, 106, 0) 0%,
			var(--gold-soft) 6%,
			var(--gold-soft) 94%,
			rgba(201, 168, 106, 0) 100%
		);
	}

	.tl-stop {
		position: relative;
		flex: 0 0 340px;
		width: 340px;
		display: flex;
		flex-direction: column;
		gap: var(--tl-stack-gap);
		scroll-snap-align: center;
	}

	.tl-media {
		width: 100%;
		height: var(--tl-media-h);
		object-fit: cover;
		border-radius: var(--radius-media);
		border: 1px solid var(--card-border);
		background: var(--panel);
