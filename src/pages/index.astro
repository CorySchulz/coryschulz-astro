2.408-10.526 50.414-4.155 22.99 8.033 34.625-31.578 3.6-31.578-19.112 0-51.521 13.85-60.663 33.794-5.54-1.385-11.08-2.216-17.173-2.216-30.47 0-55.124 19.667-55.124 44.043 0 13.573 7.757 25.761 19.944 33.794-7.479 2.493-13.85 8.31-14.958 16.62-3.55 23.162 17.085 27.903 37.533 32.602 16.233 3.73 32.35 7.433 36.15 20.305 3.6 11.634-9.419 22.714-24.93 22.714-16.067 0-18.836-22.16-4.986-22.16 0-24.099-45.151-27.7-45.151 1.385 0 43.489 110.522 44.043 103.044-15.789-4.107-31.731-37.267-34.534-60.072-36.462-11.038-.933-19.65-1.66-21.367-5.365-1.938-4.155 0-7.202 3.325-9.141m-41.274.831c0 21.606 12.742 18.559 13.297 22.437.276 1.662-1.386 2.77-2.77 2.77-.146 0-.706-.129-1.605-.335-5.959-1.37-26.818-6.163-40.776.335v-13.019c-4.987 6.648-17.728 13.019-36.841 13.019-31.302 0-41.828-35.733-4.433-50.137 14.959-5.817 41.274-9.418 41.274-23.268 0-14.127-6.926-26.038-19.944-24.099-14.958 2.493-16.067 25.207-.832 25.207 0 19.944-39.887 22.991-39.887-2.77 0-18.005 19.944-33.517 44.597-33.517 28.253 0 47.92 12.188 47.92 43.766zm172.849 0v-80.33c0-3.601-3.324-4.432-6.371-.554-3.879 4.432-22.715 15.235-35.733 15.235-1.663 0-2.77 1.108-3.047 2.493-.084 1.172 1.123 2.167 2.848 3.59 3.982 3.282 10.725 8.841 10.725 24.11v35.456c0 21.606-12.742 18.559-13.573 22.437 0 1.662 1.384 2.77 3.047 2.77 3.324 0 16.342-3.324 26.315-3.324 9.971 0 23.268 3.324 26.591 3.324 1.385 0 3.047-1.108 2.77-2.77-.554-3.878-13.572-.831-13.572-22.437m112.739-5.263c-16.067 16.897-62.88 21.883-62.88-23.822 0-23.268 9.696-42.381 25.485-41.273 17.727 1.385 16.343 33.24-2.77 29.639 0 32.686 37.671 22.437 44.043 4.432 8.032-23.822-14.958-47.09-46.536-47.09-31.302 0-56.786 24.376-56.786 54.292s25.484 54.292 56.786 54.292c20.22 0 40.718-13.019 49.583-29.362 2.216-4.155-3.325-4.709-6.925-1.108m-349.02 6.094c3.6 14.127 21.052 10.526 31.578-2.216v-27.7c-1.782 1.559-5.175 3.337-9.108 5.397-10.742 5.629-25.512 13.367-22.47 24.519m131.298-72.02c8.863 0 16.065 14.127 16.065 31.855 0 17.451-7.202 31.578-16.065 31.578-8.865 0-15.79-14.127-15.79-31.578 0-17.728 6.925-31.855 15.79-31.855';

const STAR = 'M9 1 L10.8 7.2 L17 9 L10.8 10.8 L9 17 L7.2 10.8 L1 9 L7.2 7.2 Z';
---

<Layout title="Cory Schulz - Front-End Engineer, Tech Lead & Shopify Developer">
	<a class="skip-link" href="#experience">Skip to content</a>

	<main id="top">
		<!-- ============ HERO ============ -->
		<section class="hero">
			<svg class="constellation" viewBox="0 0 1200 360" aria-hidden="true" focusable="false">
				<circle class="twinkle twinkle-a" cx="80" cy="60" r="1.6" fill="var(--gold)"></circle>
				<circle cx="220" cy="180" r="1.1" fill="var(--cream)" opacity="0.5"></circle>
				<circle class="twinkle twinkle-b" cx="360" cy="40" r="1.3" fill="var(--cream)" opacity="0.4"></circle>
				<circle cx="540" cy="120" r="1.0" fill="var(--gold)" opacity="0.6"></circle>
				<circle class="twinkle twinkle-c" cx="700" cy="30" r="1.5" fill="var(--cream)" opacity="0.45"></circle>
				<circle cx="860" cy="150" r="1.2" fill="var(--gold)" opacity="0.7"></circle>
				<circle class="twinkle twinkle-d" cx="1000" cy="70" r="1.6" fill="var(--cream)" opacity="0.4"></circle>
				<circle cx="1120" cy="200" r="1.1" fill="var(--gold)" opacity="0.6"></circle>
				<circle cx="160" cy="300" r="1.2" fill="var(--cream)" opacity="0.35"></circle>
				<circle class="twinkle twinkle-e" cx="1040" cy="310" r="1.3" fill="var(--cream)" opacity="0.4"></circle>
				</svg>

			<p class="eyebrow hero-eyebrow">
				<span>Front-End Engineer &middot; Tech Lead</span><span class="eyebrow-sep"> &middot; </span><span>Shopify Developer</span>
			</p>

			<h1 class="hero-name">
				<split-text split="chars" trigger="load" stagger="34" duration="900"
					><span class="hero-name-part">Cory</span> <span class="hero-name-part">Schulz</span></split-text
				>
			</h1>

			<p class="hero-thesis">
				I love to design beautiful experiences and build tools that help other people create more amazing
				things.
			</p>
			<p class="hero-sub">
				Creator of Magic Spells and the Tarot carousel &middot; twenty years of building for the web
			</p>

			<div class="hero-actions">
				<a class="pill pill-gold" href="#contact" data-scroll-to-contact>Send a Message</a>
				<a
					class="pill pill-outline"
					href="https://www.linkedin.com/in/cory-schulz/"
					target="_blank"
					rel="noopener noreferrer">
					LinkedIn
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path
							d="M7 17 L17 7 M9 7 L17 7 L17 15"
							stroke="var(--gold)"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
					</svg>
				</a>
			</div>
		</section>

		<!-- ============ TIMELINE ============ -->
		<section class="section section-timeline" id="experience">
			<!-- Desktop: scroll-scrubbed horizontal strip. The heading rides inside
			     the pinned area so it stays with the strip while it scrubs. -->
			<div class="tl-scroll" id="tl-scroll">
				<div class="tl-pin">
					<div class="section-head reveal reveal-fade-up">
						<p class="eyebrow">2013 &mdash; Today</p>
						<h2 class="section-title">Where I&rsquo;ve Been</h2>
						<p class="section-intro">
							From a Fortune-500 rewrite to founding an open-source component library.
						</p>
					</div>
					<div class="tl-viewport" id="tl-viewport">
						<div class="tl-strip" id="tl-strip">
							<div class="tl-rule" aria-hidden="true"></div>
							{
								stops.map((s) => (
									<article class="tl-stop">
										{s.img ? (
											<img class="tl-media" src={s.img} alt={s.alt} loading="lazy" decoding="async" />
										) : (
											<div class="tl-media tl-media-mark">
												<svg
													class="ms-logo"
													viewBox="0 0 1193 238"
													role="img"
													aria-label="Magic Spells">
													<path d={MS_LOGO} fill="currentColor" />
												</svg>
											</div>
										)}
										<svg class="tl-node" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
											<path d={STAR} fill={s.img ? 'var(--gold)' : 'var(--gold-bright)'} />
										</svg>
										<div class="tl-text">
											<p class="tl-year">{s.year}</p>
											<h3 class="tl-company">{s.company}</h3>
											<p class="tl-desc">{s.desc}</p>
										</div>
									</article>
								))
							}
						</div>
					</div>
				</div>
			</div>

			<!-- Mobile: ledger rows -->
			<ol class="tl-ledger">
				{
					stops.map((s) => (
						<li class="tl-row reveal reveal-fade-up" data-reveal-group="ledger:70">
							<p class="tl-row-year">{s.shortYear}</p>
							<div class="tl-row-body">
								<h3 class="tl-row-company">{s.company}</h3>
								<p class="tl-row-desc">{s.desc}</p>
							</div>
							{s.img ? (
								<img class="tl-row-thumb" src={s.img} alt={s.alt} loading="lazy" decoding="async" />
							) : (
								<div class="tl-row-thumb tl-media-mark">
									<svg
										class="ms-logo ms-logo-sm"
										viewBox="0 0 1193 238"
										role="img"
										aria-label="Magic Spells">
										<path d={MS_LOGO} fill="currentColor" />
									</svg>
								</div>
							)}
						</li>
					))
				}
			</ol>
		</section>

		<!-- ============ THINGS I'VE BUILT ============ -->
		<section class="section" id="projects">
			<div class="section-head reveal reveal-fade-up">
				<p class="eyebrow">Free &amp; Open Source</p>
				<h2 class="section-title">Things I&rsquo;ve Built</h2>
			</div>

			<div class="built-grid">
				<!-- TAROT -->
				<article class="built-card reveal reveal-fade-up" data-reveal-group="built:110">
					<div class="built-media built-media-tarot">
						<tarot-carousel>
							<script type="application/json" data-tarot-options>
								{
									"effect": "butterfly",
									"goToSelectedSlide": true,
									"initialIndex": 2,
									"loop": true,
									"gap": 10,
									"paddingLeft": "22%",
									"paddingRight": "22%",
									"slidesPerView": 1,
									"navigation": {
										"showButtons": false,
										"showPagination": true,
										"paginationPosition": "bottom",
										"buttonsPosition": "bottom"
									}
								}
							</script>
							<tarot-viewport>
								{
									tarotSlides.map((s) => (
										<tarot-slide class="tarot-mini-slide">
											<img src={s.img} alt={s.alt} loading="lazy" decoding="async" />
										</tarot-slide>
									))
								}
							</tarot-viewport>
						</tarot-carousel>
					</div>
					<h3 class="built-title">Tarot</h3>
					<p class="built-desc">
						A carousel with real physics &mdash; springy, scrubbable, and fun to flick. Five effects and
						counting.
					</p>
				</article>

				<!-- TIMELINE ENGINE -->
				<article class="built-card reveal reveal-fade-up" data-reveal-group="built:110">
					<div class="built-media">
						<svg class="ruler" width="220" height="110" viewBox="0 0 220 110" aria-hidden="true">
							<line x1="10" y1="55" x2="210" y2="55" stroke="var(--rule-soft)" stroke-width="1"></line>
							<line x1="10" y1="47" x2="10" y2="63" stroke="var(--rule-tick)" stroke-width="1"></line>
							<line x1="60" y1="49" x2="60" y2="61" stroke="var(--rule-tick)" stroke-width="1"></line>
							<line x1="110" y1="47" x2="110" y2="63" stroke="var(--rule-tick)" stroke-width="1"></line>
							<line x1="160" y1="49" x2="160" y2="61" stroke="var(--rule-tick)" stroke-width="1"></line>
							<line x1="210" y1="47" x2="210" y2="63" stroke="var(--rule-tick)" stroke-width="1"></line>
							<path d="M60 55 L66 49 L72 55 L66 61 Z" fill="var(--gold)"></path>
							<path d="M132 55 L138 49 L144 55 L138 61 Z" fill="var(--gold)"></path>
							<path d="M176 55 L182 49 L188 55 L182 61 Z" fill="var(--gold-soft)"></path>
							<g class="playhead">
								<line x1="10" y1="20" x2="10" y2="90" stroke="var(--gold-bright)" stroke-width="2"></line>
								<circle cx="10" cy="20" r="4" fill="var(--gold-bright)"></circle>
							</g>
						</svg>
					</div>
					<h3 class="built-title">Timeline Engine</h3>
					<p class="built-desc">
						Scrubbable keyframe timelines &mdash; play them with a clock, or drive them with scroll.
					</p>
				</article>

				<!-- SPLIT TEXT -->
				<article class="built-card reveal reveal-fade-up" data-reveal-group="built:110">
					<div class="built-media built-media-rises">
						<split-text
							class="rises"
							split="chars"
							effect="rise"
							stagger="90"
							duration="900"
							offset="10%">Rises</split-text
						>
					</div>
					<h3 class="built-title">Split Text</h3>
					<p class="built-desc">
						Text that rises into place &mdash; by word, character, or line. No dependencies.
					</p>
				</article>
			</div>

			<ul class="chips reveal reveal-fade-up">
				{chips.map((c) => <li class="chip">{c}</li>)}
			</ul>

			<p class="built-footnote reveal reveal-fade-up">
				All free and open source at <a
					href="https://magicspells.io"
					target="_blank"
					rel="noopener noreferrer">magicspells.io</a
				>
			</p>
		</section>

		<!-- ============ CONTACT ============ -->
		<section class="section section-contact" id="contact">
			<div class="contact-inner">
				<div class="section-head reveal reveal-fade-up">
					<img class="portrait" src="/cory.jpg" alt="Cory Schulz" width="76" height="76" loading="lazy" />
					<h2 class="section-title">Have a Project in Mind?</h2>
					<p class="contact-sub">
						Tell me what you&rsquo;re building. If it sounds like a good fit, I&rsquo;ll get back to you as
						soon as I can.
					</p>
				</div>

				<!-- Success Message -->
				<div id="success-message" class="form-note form-note-ok" hidden>
					<p>Thanks for reaching out! I&rsquo;ll get back to you soon.</p>
				</div>

				<!-- Error Message -->
				<div id="error-message" class="form-note form-note-err" hidden>
					<p>Oops! Something went wrong. Please try again.</p>
				</div>

				<form id="contact-form" class="contact-form" action="https://api.web3forms.com/submit" method="POST">
					<!-- Hidden fields -->
					<input type="hidden" name="access_key" value="585a106a-78ff-4313-b4c9-459b73515114" />
