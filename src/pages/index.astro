---
import Layout from '../layouts/Layout.astro';

const stops = [
	{
		year: '2013',
		shortYear: "'13",
		company: "Kohl's",
		desc: "Lead Web Developer — rewrote the Kohls.com front end",
		img: '/kohls.jpg',
		alt: 'Kohls.com',
	},
	{
		year: '2016',
		shortYear: "'16",
		company: 'Pair',
		desc: 'Co-founded a consultancy — Milwaukee Tool, Empire Level',
		img: '/milwaukee.png',
		alt: 'Milwaukee Tool',
	},
	{
		year: '2018',
		shortYear: "'18",
		company: 'Fuel Made',
		desc: 'Custom Shopify themes — Casamigos Tequila',
		img: '/casamigos.jpg',
		alt: 'Casamigos',
	},
	{
		year: '2022',
		shortYear: "'22",
		company: 'Pura',
		desc: 'Tech Lead — rebuilt pura.com, hired & trained the team',
		img: '/pura.png',
		alt: 'Pura',
	},
	{
		year: '2024',
		shortYear: "'24",
		company: 'Magic Spells',
		desc: 'Founder — open-source web components',
		img: null,
		alt: 'Magic Spells',
	},
	{
		year: '2025',
		shortYear: "'25",
		company: 'Elva',
		desc: 'Front-end development — Dashing Diva',
		img: '/dashing-diva.png',
		alt: 'Dashing Diva',
	},
	{
		year: '2026',
		shortYear: "'26",
		company: 'Avex',
		desc: 'Tech Lead — sole front-end developer for Cherokee Uniforms',
		img: null,
		// Brand card rather than a site screenshot: the wordmark, recoloured
		// white, centred on Cherokee's brand blue.
		logo: '/cherokee-logo.svg',
		logoBg: '#000193',
		alt: 'Cherokee Uniforms',
	},
];

const heroStats = [
	{ num: '20+', label: 'years full-stack' },
	{ num: '11', label: 'years Shopify' },
	{ num: '5', label: 'years design' },
	{ num: '2', label: 'years AI' },
];

const splitEffects = [
	'rise',
	'drop',
	'slide-right',
	'slide-left',
	'bloom',
	'spin-x',
	'spin-y',
	'magnetic',
];

const chips = ['Animation Engine', 'Reveal', 'Scroll Trigger', 'Scroll Progress', 'Dropdown Select'];

// Ordered so neighbours contrast in the peacock spread — the two dark cards
// never sit next to each other.
const tarotSlides = [
	{ img: '/dashing-diva.png', alt: 'Dashing Diva' },
	{ img: '/homage.png', alt: 'Homage' },
	{ img: '/braxley.jpg', alt: 'Braxley Bands' },
	{ img: '/rosita.jpg', alt: 'Rosita' },
	{ img: '/kohls.jpg', alt: "Kohl's" },
	{ img: '/casamigos.jpg', alt: 'Casamigos' },
	{ img: '/ritual.png', alt: 'Ritual Hockey' },
];

// Magic Spells wordmark, inlined from the magicspells.io Logo component so
// it can be painted with a token colour (viewBox 0 0 1193 238, single path).
const MS_LOGO = 'M1156.348 83.463c4.709 16.62 40.996 13.019 36.287-6.371-3.047-12.742-21.052-21.606-49.307-20.221-29.361 1.662-43.489 18.559-39.61 34.625 1.662 6.925 7.202 14.958 14.958 20.221l3.047 1.939c12.188 7.202 32.131 14.681 35.178 27.146 2.217 9.141-3.877 14.404-12.464 14.404-11.635.277-18.837-12.465-5.54-16.343-4.71-16.62-40.72-13.019-36.288 6.371 3.047 12.465 21.33 21.329 49.584 19.944 29.084-1.385 43.489-18.282 39.61-34.625-1.662-6.925-6.647-14.958-14.68-20.498l-2.77-1.662c-12.188-7.479-32.963-14.404-36.01-27.146-1.94-8.864 3.877-14.127 12.464-14.404 11.912 0 18.837 12.742 5.54 16.62M198.482 13.659c.276-1.662-1.386-2.493-3.048-2.493-1.385 0-17.45 3.601-30.746 3.601-13.02 0-29.086-3.601-30.747-3.601-1.386 0-3.048.831-2.77 2.493.554 2.77 6.925 2.216 10.802 8.864l-39.056 68.419-39.612-69.804c3.879-5.263 9.419-4.986 9.696-7.479.276-1.662-1.385-2.493-2.77-2.493H8.736c-1.662 0-3.048.831-2.77 2.493.554 4.155 13.296.831 13.296 22.437v98.058c0 21.606-17.728 24.653-18.283 28.531-.277 1.662 1.386 2.77 2.77 2.77 1.662 0 10.804-3.601 21.606-3.601 10.25 0 19.944 3.601 21.607 3.601 1.661 0 3.323-1.108 3.046-2.77-.83-3.878-18.558-6.925-18.558-28.531V49.115l51.245 85.039 4.155 7.202 22.437-39.334 35.456-62.325v100.551c0 21.606-13.02 18.559-13.573 22.437-.278 1.662 1.384 2.77 2.77 2.77 1.661 0 17.728-3.878 30.746-3.878 13.297 0 29.362 3.878 30.747 3.878 1.662 0 3.324-1.108 3.048-2.77-.832-3.878-13.574-.831-13.574-22.437V36.096c0-21.606 12.742-18.282 13.574-22.437m-95.289 77.56v-.277l6.095 11.08Zm813.826 23.268c2.216 42.104 47.09 37.118 62.88 21.052 3.877-4.155 9.14-3.601 6.924.554-8.864 16.343-29.362 29.362-49.583 29.362-31.3 0-56.784-24.376-56.784-54.292s25.484-54.292 56.784-54.292c43.766 0 56.232 35.179 37.119 54.846-14.404 15.235-47.922 19.113-57.34 2.77M1087.651 3.133v136.838c0 21.883 13.02 18.559 13.573 22.714.277 1.662-1.385 2.493-2.77 2.493-3.324 0-16.62-3.047-26.591-3.047s-23.269 3.047-26.316 3.047h-2.77c-3.047 0-16.343-3.047-26.314-3.047-9.973 0-23.269 3.047-26.59