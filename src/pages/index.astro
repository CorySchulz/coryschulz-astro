<script>
	import '@magic-spells/dropdown-select';
	import '@magic-spells/split-text';
	import Reveal from '@magic-spells/reveal';
	import { timeline, scrollDriver } from '@magic-spells/timeline-engine';

	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

	// ---- Scroll reveals ------------------------------------------------------
	Reveal.init({ offset: 100, once: true });

	// ---- Timeline: scroll-scrubbed horizontal strip (desktop only) ----------
	const scrollEl = document.getElementById('tl-scroll') as HTMLElement | null;
	const stripEl = document.getElementById('tl-strip') as HTMLElement | null;
	const viewportEl = document.getElementById('tl-viewport') as HTMLElement | null;

	const desktop = window.matchMedia('(min-width: 768px)');

	let scrub: { destroy: () => void } | null = null;

	function buildScrub() {
		if (!scrollEl || !stripEl || !viewportEl) return;
		if (!desktop.matches || reduced.matches) return;

		// Pin first, then measure the real travel distance.
		scrollEl.classList.add('is-scrubbed');
		const travel = Math.round(stripEl.scrollWidth - viewportEl.clientWidth);

		if (travel <= 0) {
			scrollEl.classList.remove('is-scrubbed');
			return;
		}

		// 1:1 scroll feel — the pinned viewport plus exactly the horizontal travel.
		scrollEl.style.height = `${window.innerHeight + travel}px`;

		const tl = timeline();
		tl.tween(
			'#tl-strip',
			{
				0: { transform: 'translateX(0px)' },
				100: { transform: `translateX(${-travel}px)` },
			},
			{ duration: 1000, easing: 'linear' }
		);

		const driver = scrollDriver(tl, {
			trigger: '#tl-scroll',
			start: 'top top',
			end: 'bottom bottom',
			smoothing: 90,
		});

		scrub = {
			destroy() {
				driver.destroy();
				tl.destroy();
				scrollEl.classList.remove('is-scrubbed');
				scrollEl.style.height = '';
				stripEl.style.transform = '';
			},
		};
	}

	function teardownScrub() {
		if (scrub) {
			scrub.destroy();
			scrub = null;
		}
	}

	function rebuildScrub() {
		teardownScrub();
		buildScrub();
	}

	buildScrub();

	// Only re-measure when the width actually changes. Height-only resizes
	// (mobile URL bars, devtools) would otherwise collapse the pinned region
	// and yank the reader's scroll position mid-scrub.
	let lastWidth = window.innerWidth;
	let resizeTimer: number | undefined;
	window.addEventListener('resize', () => {
		if (window.innerWidth === lastWidth) return;
		lastWidth = window.innerWidth;
		window.clearTimeout(resizeTimer);
		resizeTimer = window.setTimeout(rebuildScrub, 200);
	});

	desktop.addEventListener('change', rebuildScrub);
	reduced.addEventListener('change', rebuildScrub);
</script>

<script is:inline>
	// Web3Forms Contact Form Handler
	const form = document.getElementById('contact-form');
	const submitButton = document.getElementById('submit-button');
	const buttonText = document.getElementById('button-text');
	const successMessage = document.getElementById('success-message');
	const errorMessage = document.getElementById('error-message');

	form.addEventListener('submit', async (e) => {
		e.preventDefault();

		// Disable submit button and show loading state
		submitButton.disabled = true;
		buttonText.textContent = 'Sending...';

		// Hide any previous messages
		successMessage.hidden = true;
		errorMessage.hidden = true;

		// Get form data
		const formData = new FormData(form);

		try {
			// Submit to Web3Forms
			const response = await fetch('https://api.web3forms.com/submit', {
				method: 'POST',
				body: formData,
			});

			const data = await response.json();

			if (data.success) {
				// Show success message
				successMessage.hidden = false;

				// Reset form
				form.reset();

				// Reset button
				buttonText.textContent = 'Send Message';
				submitButton.disabled = false;

				// Hide success message after 5 seconds
				setTimeout(() => {
					successMessage.hidden = true;
				}, 5000);
			} else {
				throw new Error('Form submission failed');
			}
		} catch (error) {
			// Show error message
			errorMessage.hidden = false;

			// Reset button
			buttonText.textContent = 'Send Message';
			submitButton.disabled = false;

			// Hide error message after 5 seconds
			setTimeout(() => {
				errorMessage.hidden = true;
			}, 5000);

			console.error('Form submission error:', error);
		}
	});

	// Smooth scroll to contact form
	const contactSection = document.getElementById('contact');
	document.querySelectorAll('[data-scroll-to-contact]').forEach((el) => {
		el.addEventListener('click', (e) => {
			if (!contactSection) return;
			e.preventDefault();
			contactSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
		});
	});
</script>
