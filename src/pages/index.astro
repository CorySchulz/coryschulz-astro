<script>
	import '@magic-spells/dropdown-select';
	import '@magic-spells/split-text';
	// Registers <scrolling-content> and injects its own layered stylesheet.
	// Reduced motion is handled inside the component: the loop never starts and
	// the rows stay a scrubbable strip.
	import '@magic-spells/scrolling-content';
	import Reveal from '@magic-spells/reveal';
	import { timeline, scrollDriver } from '@magic-spells/timeline-engine';

	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

	// ---- Scroll reveals ------------------------------------------------------
	Reveal.init({ offset: 100, once: true });

	// ---- Timeline: scroll-scrubbed horizontal strip (desktop only) ----------
	const scrollEl = document.getElementById('tl-scroll') as HTMLElement | null;
	const stripEl = document.getElementById('tl-strip') as HTMLElement | null;
	const viewportEl = document.getElementById('tl-viewport') as HTMLElement | null;

	const desktop = window.matchMedia('(min-width: 768px)');

	let scrub: { destroy: () => void } | null = null;

	function buildScrub() {
		if (!scrollEl || !stripEl || !viewportEl) return;
		if (!desktop.matches) {
			scrollEl.classList.remove('tl-fits');
			return;
		}

		// Pin first, then measure the real travel distance — pinning collapses
		// the section's height, which can take the page scrollbar with it and
		// change how much room the viewport actually has.
		const canPin = !reduced.matches;
		if (canPin) scrollEl.classList.add('is-scrubbed');
		// scrollWidth is the full track including its own padding-inline, so the
		// last card clears the right edge by the same gutter the first one has.
		const travel = Math.round(stripEl.scrollWidth - viewportEl.clientWidth);

		// Wide enough that the whole strip fits: nothing to travel, so no pin
		// and no transform — the page just scrolls through. .tl-fits centres
		// the strip so it doesn't sit flush-left with dead space beside it.
		// The resize handler re-runs this in both directions, so shrinking the
		// window re-engages the scrub and widening it releases again.
		scrollEl.classList.toggle('tl-fits', travel <= 0);

		if (travel <= 0 || !canPin) {
			scrollEl.classList.remove('is-scrubbed');
			return;
		}

		// 1:1 scroll feel — the pinned viewport plus exactly the horizontal travel.
		scrollEl.style.height = `${window.innerHeight + travel}px`;

		const tl = timeline();
		tl.tween(
			'#tl-strip',
			{
				0: { transform: 'translateX(0px)' },
				100: { transform: `translateX(${-travel}px)` },
			},
			{ duration: 1000, easing: 'linear' }
		);

		const driver = scrollDriver(tl, {
			trigger: '#tl-scroll',
			start: 'top top',
			end: 'bottom bottom',
			smoothing: 90,
		});

		scrub = {
			destroy() {
				driver.destroy();
				tl.destroy();
				scrollEl.classList.remove('is-scrubbed');
				scrollEl.style.height = '';
				stripEl.style.transform = '';
