	/* ============================================ */
	/* Timeline — desktop scrubbed strip             */
	/* ============================================ */

	.tl-scroll {
		position: relative;
	}

	.tl-pin {
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.tl-viewport {
		/* Edge to edge: the strip is deliberately outside .container and takes
		   the full viewport width, so cards run off the screen edge rather than
		   stopping at a gutter line. The side breathing room lives on the track
		   below (.tl-strip padding-inline), which the travel math picks up
		   because scrollWidth includes it. */
		width: 100%;
		overflow-x: auto;
		overflow-y: hidden;
		scroll-snap-type: x mandatory;
		scrollbar-width: thin;
		scrollbar-color: var(--hairline-strong) transparent;
		padding-bottom: 1rem;
	}

	.tl-strip {
		/* One source of truth for the strip's vertical metrics, so the gold
		   hairline lands on the exact centre of the star nodes. */
		--tl-media-h: 190px;
		--tl-stack-gap: 0.75rem;
		--tl-node-size: 18px;
		--tl-node-margin: 2px;

		position: relative;
		display: flex;
		gap: 3rem;
		width: max-content;
		/* The track carries the side spacing, not the viewport — that keeps the
		   viewport full-bleed while the first and last cards still clear the
		   screen edge. scrollWidth counts this padding, so the scrub travels
		   the whole track. */
		padding-inline: var(--gutter);
	}

	/* Very wide displays: the whole strip fits, so there is no travel and no
	   pin (see buildScrub). Without this it would sit flush-left with dead
	   space to the right; margin auto on a max-content block centres it. */
	.tl-scroll.tl-fits .tl-strip {
		margin-inline: auto;
	}

	.tl-rule {
		position: absolute;
		/* media + stack gap + node's top margin + half the node = node centre.
		   translateY(-50%) then centres the rule's own thickness on that line,
		   so it stays exact whatever the rule's height is. */
		top: calc(
			var(--tl-media-h) + var(--tl-stack-gap) + var(--tl-node-margin) + var(--tl-node-size) / 2
		);
		transform: translateY(-50%);
		left: 0;
		right: 0;
		height: 1px;
		background: linear-gradient(
			90deg,
			rgba(201, 168, 106, 0) 0%,
			var(--gold-soft) 6%,
			var(--gold-soft) 94%,
			rgba(201, 168, 106, 0) 100%
		);
	}

	.tl-stop {
		position: relative;
		flex: 0 0 340px;
		width: 340px;
		display: flex;
		flex-direction: column;
		gap: var(--tl-stack-gap);
		scroll-snap-align: center;
	}

	.tl-media {
		width: 100%;
		height: var(--tl-media-h);
		object-fit: cover;
		border-radius: var(--radius-media);
		border: 1px solid var(--card-border);
		background: var(--panel);
	}

	.tl-media-mark {
		display: flex;
		align-items: center;
		justify-content: center;
		border-color: rgba(201, 168, 106, 0.4);
		background: linear-gradient(160deg, #0b1626 0%, var(--ground) 100%);
		/* The wordmark is inlined SVG painted with currentColor — cream reads
		   cleaner than gold against this card's dark blue gradient. */
		color: var(--cream);
	}

	/* Curated brand card: a flat brand colour behind a centred wordmark, the
	   same read as the Milwaukee and Casamigos screenshots next to it. The
	   colour comes from the stop's own data, so only the layout lives here. */
	.tl-media-brand {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1rem;
		border-color: var(--card-border);
	}

	/* The wordmark is a very wide lockup (~7:1), so it is sized off the card's
	   width and left with generous vertical whitespace. */
	.tl-brand-logo {
		width: 68%;
		height: auto;
		display: block;
	}

	.ms-logo {
		width: 150px;
		height: auto;
		display: block;
	}

	.ms-logo-sm {
		width: 74px;
	}

	.tl-node {
		margin: var(--tl-node-margin) auto;
		display: block;
		width: var(--tl-node-size);
		height: var(--tl-node-size);
	}

	.tl-text {
		display: flex;
		flex-direction: column;
		gap: 0.3125rem;
		text-align: center;
	}

	.tl-year {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1.25rem;
		color: var(--gold);
	}

	.tl-company {
		font-family: var(--font-body);
		font-size: 0.9375rem;
		font-weight: 600;
		text-transform: none;
		letter-spacing: 0;
		line-height: 1.3;
		color: var(--cream);
	}

	.tl-desc {
		font-size: 0.8125rem;
		line-height: 1.5;
		color: var(--slate-dim);
		text-wrap: pretty;
	}

	/* Pinned scrub mode — enabled by JS */
	.tl-scroll.is-scrubbed .tl-pin {
		position: sticky;
		top: 0;
		height: 100vh;
		height: 100svh;
		overflow: hidden;
	}

	.tl-scroll.is-scrubbed .tl-viewport {
		overflow: hidden;
		scroll-snap-type: none;
		padding-bottom: 0;
	}

	.tl-scroll.is-scrubbed .tl-strip {
		will-change: transform;
	}

	/* ============================================ */
	/* Timeline — mobile ledger rows                 */
	/* ============================================ */

	.tl-ledger {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--hairline);
	}

	.tl-row {
		display: grid;
		grid-template-columns: auto 1fr 104px;
		align-items: center;
		column-gap: 1.125rem;
		row-gap: 0.75rem;
		padding: 1.375rem 0;
		border-bottom: 1px solid var(--hairline);
	}

	.tl-row-year {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: clamp(2.75rem, 12vw, 3.375rem);
		line-height: 0.9;
		color: var(--gold);
		font-variant-numeric: lining-nums;
	}

	.tl-row-body {
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.tl-row-company {
		font-family: var(--font-body);
		font-size: 1rem;
		font-weight: 600;
		text-transform: none;
		letter-spacing: 0;
		line-height: 1.3;
		color: var(--cream);
	}

	.tl-row-desc {
		font-size: 0.8125rem;
		line-height: 1.5;
		color: var(--slate-dim);
		text-wrap: pretty;
	}

	.tl-row-thumb {
		width: 104px;
		height: 66px;
		object-fit: cover;
		border-radius: 6px;
		border: 1px solid var(--card-border);
		background: var(--panel);
	}

	/* At the narrowest sizes the thumb drops below the text instead of shrinking */
	@media (max-width: 419px) {
		.tl-row {
			grid-template-columns: auto 1fr;
		}
		.tl-row-thumb {
			grid-column: 2;
			width: 100%;
			height: 96px;
		}
	}

	/* Below 768px the horizontal strip is replaced by the ledger rows. */
	.tl-viewport {
		display: none;
	}

	@media (min-width: 768px) {
		.tl-viewport {
			display: block;
		}
		.tl-ledger-wrap {
			display: none;
		}
		.section-timeline {
			padding-bottom: clamp(2rem, 4vw, 3rem);
		}
	}

	/* ============================================ */
	/* Things I've built — five feature rows          */
	/* ============================================ */

	.proj-rows {
		display: flex;
		flex-direction: column;
	}

	.proj-row {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;
		align-items: center;
		padding-block: clamp(3rem, 6vw, 5rem);
		border-top: 1px solid var(--hairline);
	}

	.proj-row:first-child {
		border-top: 0;
		padding-top: 0;
	}

	@media (min-width: 900px) {
		.proj-row {
			grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
			gap: clamp(2.5rem, 5vw, 4.5rem);
		}
		/* Alternate copy-left / demo-left down the column */
		.proj-row:nth-child(even) .proj-copy {
			order: 2;
		}
		/* Cap the copy block and centre it in its column so the row reads
		   balanced against the filled demo panel instead of hugging the inner
		   edge. Auto margins are symmetric, so it works either way round.
		   The text itself stays left-aligned inside the block. */
		.proj-copy {
			max-width: 46ch;
			margin-inline: auto;
		}
	}

	.proj-copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.875rem;
		min-width: 0;
	}

	.proj-pill {
		display: inline-block;
		border: 1px solid var(--gold-faint);
		border-radius: 999px;
		padding: 0.4375rem 0.875rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--gold);
		transition:
			border-color 0.2s ease,
			color 0.2s ease;
	}

	.proj-pill:hover {
		border-color: var(--gold);
		color: var(--gold-bright);
	}

	.proj-title {
		font-size: clamp(1.75rem, 3.6vw, 2.5rem);
		color: var(--cream);
	}

	.proj-tagline {
		font-size: clamp(1.0625rem, 2vw, 1.1875rem);
		font-weight: 600;
		color: var(--cream);
		text-wrap: balance;
	}

	.proj-desc {
		font-size: 0.9375rem;
		line-height: 1.65;
		color: var(--slate-dim);
		text-wrap: pretty;
		max-width: 46ch;
	}

	.proj-desc code {
		font-family: var(--font-mono);
		font-size: 0.875em;
		color: var(--slate);
	}

	.proj-install {
		margin-top: 0.375rem;
		border: 1px solid var(--card-border);
		border-radius: 10px;
		background: var(--panel);
		padding: 0.75rem 1.125rem;
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--cream);
		max-width: 100%;
		overflow-x: auto;
		white-space: nowrap;
	}

	.proj-install .dollar {
		color: var(--gold);
		margin-right: 0.375rem;
	}

	.proj-note {
		margin-top: 0.375rem;
		font-size: 0.8125rem;
		color: var(--slate-dim);
	}

	/* Demo panels ------------------------------------------------ */

	.proj-demo {
		border: 1px solid var(--card-border);
		border-radius: var(--radius-card);
		background: var(--card-bg);
		padding: 1.75rem;
		min-height: 300px;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		min-width: 0;
	}

	/* No panel chrome at all: the carousel breaks out and fills the demo side
	   of the row. The slides' own shadows give them definition against the
	   night ground, so a border and a background would only box them in.
	   padding-bottom reserves the strip the pagination is lifted into. */
	.proj-demo-tarot {
		position: relative;
		display: block;
		border: 0;
		background: none;
		/* Top padding gives the card shadows headroom; the bottom strip is
		   where the pagination is lifted to. */
		padding: 0.75rem 0 2.5rem;
		min-height: 0;
		/* The carousel's own clipping is off below so the shadows survive, which
		   leaves its off-screen slides free to widen the page. This is the box
		   that catches them — the visible slides sit ~80px inside it, so their
		   shadows are never touched. */
		overflow: hidden;
	}

	/* Pagination out of flow, so tarot-carousel's box collapses to exactly the
	   viewport's slide area. That is what makes the buttons below centre on the
	   slides rather than on the slides-plus-dots stack. */
	.proj-demo-tarot :global(.tarot-dots-container) {
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		/* auto inline margins keep the fit-content dots centred under the card */
		margin: 0.75rem auto 0;
	}

	/* The carousel's own chrome clips at the viewport edge, which would cut the
	   card shadows off. The slides sit well inside the panel and .proj-demo
	   still clips at its rounded border, so letting these overflow is safe. */
	.proj-demo-tarot tarot-carousel,
	.proj-demo-tarot tarot-viewport {
		overflow: visible;
	}

	/* Peacock animates the slide element's own width, so the slide is the
	   visible card — it carries the corners and the shadow — while the fixed
	   geometry lives on the inner wrapper it reveals. */
	.proj-demo-tarot tarot-slide.tarot-mini-slide {
		display: block;
		border-radius: var(--radius-media);
		overflow: hidden;
		/* Two layers: a soft ambient throw plus a tight contact shadow, so the
		   card still separates from the night ground. */
		box-shadow:
			0 24px 48px -12px rgba(0, 0, 0, 0.55),
			0 4px 12px rgba(0, 0, 0, 0.4);
	}

	/* The card is a brand lockup (920x500): the frame matches that aspect and
	   the image is contained, never cropped — a logo card that loses its edges
	   looks broken. .w-tarot-slide holds the width; this centres it so the
	   slide can open and close around a card that never moves or resizes. */
	.proj-demo-tarot .tarot-mini-inner {
		position: relative;
		left: 50%;
		transform: translateX(-50%);
		aspect-ratio: 920 / 500;
		overflow: hidden;
		background: var(--panel);
	}

	/* Prev/next: circular icon buttons that ride over the slide area, hidden
	   until the carousel is hovered. The package builds these at runtime, so
	   they carry no scope attribute — hence :global(). */
	.proj-demo-tarot :global(.tarot-button) {
		/* Anchored to the viewport's slide area: tarot-carousel is the
		   positioning context and, with the dots lifted out of flow above, its
		   box is exactly tarot-viewport's box — so 50% is the slides' centre
		   line and the dots below are excluded from the maths. */
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		z-index: 2;
		width: 44px;
		height: 44px;
		padding: 0;
		display: none;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		border: 1px solid var(--hairline-strong);
		background: rgba(2, 6, 15, 0.72);
		backdrop-filter: blur(6px);
		color: var(--cream);
		opacity: 0;
		transition:
			opacity 0.25s ease,
			border-color 0.2s ease,
			color 0.2s ease;
	}

	/* Symmetric inset from the viewport's own edges. */
	.proj-demo-tarot :global(.tarot-prev) {
		left: 12px;
	}

	.proj-demo-tarot :global(.tarot-next) {
		right: 12px;
	}

	.proj-demo-tarot :global(.tarot-button svg) {
		width: 22px;
		height: 22px;
	}

	.proj-demo-tarot :global(.tarot-button:hover) {
		border-color: var(--gold);
		color: var(--gold-bright);
	}

	/* Pointer devices only — a touch screen has no hover to reveal them, so it
	   stays on pagination. Keyboard focus reveals them too, so they are never
	   reachable-but-invisible. */
	@media (hover: hover) and (min-width: 900px) {
		.proj-demo-tarot :global(.tarot-button) {
			display: flex;
		}

		.proj-demo-tarot:hover :global(.tarot-button),
		.proj-demo-tarot :global(.tarot-button:focus-visible) {
			opacity: 1;
		}
	}

	/* Everything but the fully-in-view card sits behind a soft blur, so the
	   fan reads as depth rather than five competing logos. Gated on
	   tarot-carousel:defined: if the component never upgrades, the slides stay
	   sharp instead of permanently blurred. The blur lives on the inner
	   wrapper, so the slide's overflow clips it to the rounded corners and the
	   slide's own box-shadow is left alone. */
	.proj-demo-tarot tarot-carousel:defined :global(tarot-slide.tarot-mini-slide .tarot-mini-inner) {
		filter: blur(8px);
		transition: filter 0.45s ease;
	}

	.proj-demo-tarot
		tarot-carousel:defined
		:global(tarot-slide.tarot-mini-slide.tarot-fully-visible .tarot-mini-inner) {
		filter: none;
	}

	/* tarot.min.css's peacock rule pushes slide images around with
	   position/left/transform and crops them with object-fit: cover — the
	   inner wrapper already handles placement, so undo all of that here. */
	.proj-demo-tarot .tarot-mini-inner img {
		position: static;
		left: auto;
		transform: none;
		width: 100%;
		max-width: 100%;
		height: 100%;
		object-fit: contain;
		display: block;
	}

	/* Puzzle — code card */

	.code-card {
		width: 100%;
		margin: 0;
		background: var(--panel);
		border-radius: 10px;
		padding: 1.25rem 1.375rem;
		font-family: var(--font-mono);
		font-size: 0.78125rem;
		line-height: 1.75;
		color: var(--cream);
		overflow-x: auto;
		tab-size: 2;
	}

	.c-tag {
		color: var(--gold);
	}
	.c-punc {
		color: var(--slate-dim);
	}
	.c-attr {
		color: var(--slate);
	}
	.c-str,
	.c-evt,
	.c-bind,
	.c-num {
		color: var(--gold-bright);
	}
	.c-kw {
		color: var(--slate);
	}
	.c-fn {
		color: var(--cream);
	}

	/* Timeline engine — the ported fireworks demo brings its own CSS.
	   The mount point drops this card's padding so the demo owns its chrome. */

	.proj-demo-bare {
		display: block;
	}

	/* ...but only until the demo is actually there. initFireworks() adds
	   `.fw-demo`, which paints the panel itself (padding, border, background);
	   this rule is scoped so it hands that job over rather than fighting
	   fireworks.css on specificity and winning — which stripped the demo's
	   chrome entirely. Before the lazy mount lands the empty box stays bare. */
	.proj-demo-bare:not(.fw-demo) {
		padding: 0;
		border: 0;
		background: none;
	}

	/* Split text — the replayable lab */

	.st-demo {
		width: 100%;
		display: flex;
		flex-direction: column;
	}

	.st-stage {
		min-height: 118px;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		font-family: var(--font-display);
		font-weight: 800;
		font-size: clamp(1.25rem, 2.8vw, 1.875rem);
		text-transform: uppercase;
		line-height: 1.3;
		letter-spacing: 0.04em;
		color: var(--cream);
		--split-text-blur: 8px;
		--split-text-scale: 0.82;
	}

	/* Fields caps are shaved by split-text's per-character overflow mask without
	   this headroom — the same fix the magicspells.io demo carries, and the
	   reason the stage sets line-height 1.3 rather than something tighter. */
	.st-stage :global(.split-text-char) {
		padding-top: 0.24em;
	}

	.st-controls {
		margin-top: 1.75rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--hairline);
	}

	.st-label {
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.28em;
		text-transform: uppercase;
		color: var(--slate-dim);
	}

	.st-effects {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1rem;
	}

	.st-chip {
		border: 1px solid var(--hairline-strong);
		background: rgba(251, 248, 238, 0.04);
		border-radius: 999px;
		padding: 0.375rem 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.08em;
		color: var(--slate);
		cursor: pointer;
		transition:
			border-color 0.2s ease,
			background-color 0.2s ease,
			color 0.2s ease;
	}

	.st-chip:hover {
		border-color: var(--gold-soft);
		color: var(--cream);
	}

	.st-chip[aria-pressed='true'] {
		border-color: var(--gold);
		background: rgba(201, 168, 106, 0.15);
		color: var(--gold-bright);
	}

	.st-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.5rem;
		margin-top: 1.5rem;
	}

	.st-replay {
		border: 1px solid var(--hairline-strong);
		background: transparent;
		border-radius: 999px;
		padding: 0.5rem 1.25rem;
		font-family: var(--font-body);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--cream);
		cursor: pointer;
		transition:
			border-color 0.2s ease,
			color 0.2s ease;
	}

	.st-replay:hover {
		border-color: var(--gold);
		color: var(--gold-bright);
	}

	.st-code {
		min-width: 0;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.02em;
		color: var(--slate-dim);
		word-break: break-all;
	}

	/* Constellation — node-graph field */

	.cf-wrap {
		width: 100%;
		height: 290px;
		border-radius: 10px;
		overflow: hidden;
		background: var(--panel);
	}

	#cf-canvas {
		display: block;
		width: 100%;
		height: 100%;
	}

	/* Chips */
	.chips {
		display: flex;
		justify-content: center;
		gap: 0.75rem;
		flex-wrap: wrap;
		list-style: none;
		margin: clamp(2.5rem, 5vw, 4rem) 0 1.75rem;
		padding: 0;
	}

	.chip {
		font-size: 0.8125rem;
		font-weight: 500;
		color: var(--slate);
		border: 1px solid rgba(251, 248, 238, 0.15);
		padding: 0.5625rem 1.125rem;
		border-radius: 999px;
	}

	.built-footnote {
		text-align: center;
		font-size: 0.875rem;
		color: var(--slate-dim);
	}

	.built-footnote a {
		font-weight: 600;
	}

	/* ============================================ */
	/* Contact                                       */
	/* ============================================ */

	.contact-inner {
		max-width: 720px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	.portrait {
		width: 76px;
		height: 76px;
		border-radius: 50%;
		object-fit: cover;
		border: 2px solid rgba(201, 168, 106, 0.6);
	}

	.contact-sub {
		font-size: 1.0625rem;
		line-height: 1.6;
		color: var(--slate-dim);
		max-width: 520px;
		text-wrap: pretty;
	}

	.contact-form {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.field-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.25rem;
	}

	@media (min-width: 640px) {
		.field-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.contact-form :global(input[type='text']),
	.contact-form :global(input[type='email']),
	.contact-form :global(textarea) {
		width: 100%;
		background: transparent;
		border: 1px solid var(--hairline-strong);
		border-radius: var(--radius-input);
		padding: 1.5rem 1.25rem 0.75rem;
		font-family: var(--font-body);
		font-size: 0.9375rem;
		color: var(--cream);
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.contact-form :global(textarea) {
		min-height: 120px;
		resize: vertical;
		display: block;
	}

	.contact-form :global(input[type='text']):focus,
	.contact-form :global(input[type='email']):focus,
	.contact-form :global(textarea):focus {
		outline: none;
		border-color: var(--gold);
		box-shadow: 0 0 0 3px rgba(201, 168, 106, 0.18);
	}

	.field-legend {
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--slate-dim);
		margin-bottom: 0.625rem;
		padding: 0;
	}

	/* The package's own stylesheet loads after app.css, so the host's width is
	   re-asserted here where the scoped selector outranks it. */
	.budget-field :global(dropdown-select) {
		display: block;
		width: 100%;
	}

	/* dropdown-select appends its own caret, so the chevron in the markup would
	   be a second one. Hide the package's and keep ours, which is tokenized. */
	.budget-field :global(.dropdown-caret) {
		display: none;
	}

	.budget-field :global(dropdown-select-trigger.select-trigger) {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.5rem;
		width: 100%;
		padding: 1.125rem 1.25rem;
		background: transparent;
		border: 1px solid var(--hairline-strong);
		border-radius: var(--radius-input);
		color: var(--cream);
		font-size: 0.9375rem;
		cursor: pointer;
		transition: border-color 0.2s ease;
	}

	.budget-field :global(dropdown-select-trigger.select-trigger:hover) {
		border-color: var(--gold-soft);
	}

	.budget-field :global(dropdown-options.select-options) {
		width: 100%;
		margin-top: 0.5rem;
		border-radius: var(--radius-input);
		overflow: hidden;
	}

	.budget-field :global(dropdown-option.select-option) {
		display: block;
		padding: 0.8125rem 1.25rem;
		font-size: 0.9375rem;
		cursor: pointer;
		transition: background-color 0.2s ease;
	}

	.services {
		border: 0;
		margin: 0;
		padding: 0;
		min-width: 0;
	}

	.check {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		cursor: pointer;
		font-size: 0.875rem;
		color: var(--slate);
		padding: 0.3125rem 0;
		transition: color 0.2s ease;
	}
	.check:hover {
		color: var(--cream);
	}

	.check input[type='checkbox'] {
		appearance: none;
		flex: 0 0 auto;
		width: 18px;
		height: 18px;
		border: 1px solid var(--hairline-strong);
		border-radius: 4px;
		background: transparent;
		cursor: pointer;
		display: grid;
		place-content: center;
		transition:
			border-color 0.2s ease,
			background-color 0.2s ease;
	}

	.check input[type='checkbox']::after {
		content: '';
		width: 9px;
		height: 9px;
		border-radius: 1px;
		transform: scale(0);
		transition: transform 0.15s ease;
		background: var(--ground);
	}

	.check input[type='checkbox']:checked {
		background: var(--gold);
		border-color: var(--gold);
	}

	.check input[type='checkbox']:checked::after {
		transform: scale(1);
	}

	.form-actions {
		display: flex;
		justify-content: center;
		margin-top: 0.5rem;
	}

	#submit-button {
		font-family: var(--font-body);
		padding: 1rem 2.5rem;
	}

	#submit-button:disabled {
		opacity: 0.5;
		cursor: not-allowed;
	}

	.form-note {
		border-radius: var(--radius-input);
		padding: 1.125rem 1.25rem;
		text-align: center;
		font-size: 0.9375rem;
		font-weight: 500;
	}

	.form-note-ok {
		border: 1px solid var(--ok-border);
		background: var(--ok-bg);
		color: var(--cream);
	}

	.form-note-err {
		border: 1px solid var(--err-border);
		background: var(--err-bg);
		color: var(--cream);
	}

	/* ============================================ */
	/* Footer                                        */
	/* ============================================ */

	.site-footer {
		padding-block: 1.75rem;
		border-top: 1px solid var(--hairline);
		font-size: 0.8125rem;
		color: var(--slate-dim);
	}

	.footer-inner {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.footer-links {
		display: flex;
		gap: clamp(1rem, 3vw, 1.75rem);
		flex-wrap: wrap;
	}

	.footer-links a {
		color: var(--slate);
	}
	.footer-links a:hover {
		color: var(--cream);
	}
	.footer-links a.footer-gold {
		color: var(--gold);
	}
	.footer-links a.footer-gold:hover {
		color: var(--gold-bright);
	}

	/* ============================================ */
	/* Reduced motion                                */
	/* ============================================ */

	@media (prefers-reduced-motion: reduce) {
		.twinkle {
			animation: none;
		}
		.pill:hover {
			transform: none;
		}
		.tl-scroll .tl-pin {
			position: static;
			height: auto;
			overflow: visible;
		}
		.tl-scroll .tl-viewport {
			overflow-x: auto;
		}
	}
</style>

<script>
	import '@magic-spells/dropdown-select';
	import '@magic-spells/split-text';
	import Reveal from '@magic-spells/reveal';
	import { timeline, scrollDriver } from '@magic-spells/timeline-engine';

	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

	// ---- Scroll reveals ------------------------------------------------------
	Reveal.init({ offset: 100, once: true });

	// ---- Timeline: scroll-scrubbed horizontal strip (desktop only) ----------
	const scrollEl = document.getElementById('tl-scroll') as HTMLElement | null;
	const stripEl = document.getElementById('tl-strip') as HTMLElement | null;
	const viewportEl = document.getElementById('tl-viewport') as HTMLElement | null;

	const desktop = window.matchMedia('(min-width: 768px)');

	let scrub: { destroy: () => void } | null = null;

	function buildScrub() {
		if (!scrollEl || !stripEl || !viewportEl) return;
		if (!desktop.matches) {
			scrollEl.classList.remove('tl-fits');
			return;
		}

		// Pin first, then measure the real travel distance — pinning collapses
		// the section's height, which can take the page scrollbar with it and
		// change how much room the viewport actually has.
		const canPin = !reduced.matches;
		if (canPin) scrollEl.classList.add('is-scrubbed');
		// scrollWidth is the full track including its own padding-inline, so the
		// last card clears the right edge by the same gutter the first one has.
		const travel = Math.round(stripEl.scrollWidth - viewportEl.clientWidth);

		// Wide enough that the whole strip fits: nothing to travel, so no pin
		// and no transform — the page just scrolls through. .tl-fits centres
		// the strip so it doesn't sit flush-left with dead space beside it.
		// The resize handler re-runs this in both directions, so shrinking the
		// window re-engages the scrub and widening it releases again.
		scrollEl.classList.toggle('tl-fits', travel <= 0);

		if (travel <= 0 || !canPin) {
			scrollEl.classList.remove('is-scrubbed');
			return;
		}

		// 1:1 scroll feel — the pinned viewport plus exactly the horizontal travel.
		scrollEl.style.height = `${window.innerHeight + travel}px`;

		const tl = timeline();
		tl.tween(
			'#tl-strip',
			{
				0: { transform: 'translateX(0px)' },
				100: { transform: `translateX(${-travel}px)` },
			},
			{ duration: 1000, easing: 'linear' }
		);

		const driver = scrollDriver(tl, {
			trigger: '#tl-scroll',
			start: 'top top',
			end: 'bottom bottom',
			smoothing: 90,
		});

		scrub = {
			destroy() {
				driver.destroy();
				tl.destroy();
				scrollEl.classList.remove('is-scrubbed');
				scrollEl.style.height = '';
				stripEl.style.transform = '';
			},
		};
	}

	function teardownScrub() {
		if (scrub) {
			scrub.destroy();
			scrub = null;
		}
	}

	function rebuildScrub() {
		teardownScrub();
		buildScrub();
	}

	buildScrub();

	// Only re-measure when the width actually changes. Height-only resizes
	// (mobile URL bars, devtools) would otherwise collapse the pinned region
	// and yank the reader's scroll position mid-scrub.
	let lastWidth = window.innerWidth;
	let resizeTimer: number | undefined;
	window.addEventListener('resize', () => {
		if (window.innerWidth === lastWidth) return;
		lastWidth = window.innerWidth;
		window.clearTimeout(resizeTimer);
		resizeTimer = window.setTimeout(rebuildScrub, 200);
	});

	desktop.addEventListener('change', rebuildScrub);
	reduced.addEventListener('change', rebuildScrub);

	// ---- Split Text lab ------------------------------------------------------
	// Ported from magicspells.io's SplitTextDemo. The replay contract is exact:
	// `effect` is read once inside connectedCallback while the element is
	// uninitialised, so it MUST be written before split(). split() rebuilds
	// brand-new spans (so no rAF is needed to restart the animation) and
	// reveal() then sets data-state="revealing".
	const specimen = document.getElementById('st-specimen');
	const stStage = document.getElementById('st-stage');
	const stEffects = document.getElementById('st-effects');
	const stReplay = document.getElementById('st-replay');
	const stCode = document.getElementById('st-code');

	if (specimen && stStage && stEffects && stReplay && stCode) {
		const SPLIT_MODE = 'chars';
		const markupFor = (effect) => `<split-text effect="${effect}" split="${SPLIT_MODE}">`;
		let current = 'rise';

		const play = (effect) => {
			const next = effect || current;
			specimen.setAttribute('effect', next);
			// Under reduced motion split-text marks itself revealed and never
			// splits, so the line stays plain readable text. The attribute is
			// still written above, which keeps the code line honest.
			if (reduced.matches) return;
			if (typeof specimen.split !== 'function' || typeof specimen.reveal !== 'function') return;
			specimen.split();
			specimen.reveal();
		};

		stEffects.addEventListener('click', (e) => {
			const button = (e.target as HTMLElement).closest('.st-chip') as HTMLElement | null;
			if (!button) return;
			const effect = button.dataset.effect;
			if (!effect) return;
			current = effect;
			stEffects.querySelectorAll('.st-chip').forEach((b) => {
				b.setAttribute('aria-pressed', b === button ? 'true' : 'false');
			});
			stCode.textContent = markupFor(effect);
			play(effect);
		});

		stReplay.addEventListener('click', () => play());

		// First run fires when the specimen scrolls into view, so the visitor
		// sees the reveal rather than arriving after it. trigger="manual" means
		// the element does no observing of its own.
		if (reduced.matches || typeof IntersectionObserver === 'undefined') {
			play();
		} else {
			const io = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (!entry.isIntersecting) continue;
						io.disconnect();
						play();
						break;
					}
				},
				{ threshold: 0.5 }
			);
			io.observe(stStage);
		}
	}

	// ---- Ported demos: fireworks (timeline-engine) and the constellation field
	// Both are heavy and only matter once they are near the viewport, so they
	// are code-split and mounted lazily. Both also run open-ended loops — a
	// self-rescheduling rAF and a `loop: true` timeline — that would otherwise
	// keep burning frames long after the panel has scrolled away, so the handle
	// each one returns is kept and driven from here: a second, permanent
	// observer for "is it on screen", plus the document's visibility for "is
	// anyone even looking at this tab".
	type DemoHandle = { destroy: () => void; pause?: () => void; resume?: () => void };

	const mountWhenNear = (el: Element | null, load: () => Promise<DemoHandle>) => {
		if (!el) return;

		let handle: DemoHandle | null = null;
		let onScreen = true;

		const sync = () => {
			if (!handle) return;
			if (onScreen && document.visibilityState !== 'hidden') handle.resume?.();
			else handle.pause?.();
		};

		document.addEventListener('visibilitychange', sync);

		const mount = () =>
			load()
				.then((demo) => {
					handle = demo;
					if (typeof IntersectionObserver === 'undefined') return;
					// Distinct from the loader observer above, which disconnects
					// after firing once: this one stays for the life of the page.
					const live = new IntersectionObserver(
						(entries) => {
							for (const entry of entries) onScreen = entry.isIntersecting;
							sync();
						},
						{ rootMargin: '100px' }
					);
					live.observe(el);
				})
				.catch((err) => {
					// A demo that refuses to load is a missing flourish, not a
					// broken page — say so in the console and leave the rest alone.
					console.error('demo failed to mount', err);
				});

		if (typeof IntersectionObserver === 'undefined') {
			mount();
			return;
		}
		const io = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					io.disconnect();
					mount();
					break;
				}
			},
			{ rootMargin: '200px' }
		);
		io.observe(el);
	};

	const fireworksMount = document.getElementById('fireworks-mount');
	mountWhenNear(fireworksMount, async () => {
		const { default: initFireworks } = await import('../scripts/demos/fireworks.js');
		return initFireworks(fireworksMount as HTMLElement);
	});

	const cfCanvas = document.getElementById('cf-canvas');
	mountWhenNear(cfCanvas, async () => {
		const { default: initConstellationField } = await import(
			'../scripts/demos/constellation-field.js'
		);
		return initConstellationField(cfCanvas as HTMLCanvasElement);
	});
</script>

<script is:inline>
	// Web3Forms Contact Form Handler
	const form = document.getElementById('contact-form');
	const submitButton = document.getElementById('submit-button');
	const buttonText = document.getElementById('button-text');
	const successMessage = document.getElementById('success-message');
	const errorMessage = document.getElementById('error-message');

	form.addEventListener('submit', async (e) => {
		e.preventDefault();

		// Disable submit button and show loading state
		submitButton.disabled = true;
		buttonText.textContent = 'Sending...';

		// Hide any previous messages
		successMessage.hidden = true;
		errorMessage.hidden = true;

		// Get form data
		const formData = new FormData(form);

		try {
			// Submit to Web3Forms
			const response = await fetch('https://api.web3forms.com/submit', {
				method: 'POST',
				body: formData,
			});

			const data = await response.json();

			if (data.success) {
				// Show success message
				successMessage.hidden = false;

				// Reset form
				form.reset();

				// Reset button
				buttonText.textContent = 'Send Message';
				submitButton.disabled = false;

				// Hide success message after 5 seconds
				setTimeout(() => {
					successMessage.hidden = true;
				}, 5000);
			} else {
				throw new Error('Form submission failed');
			}
		} catch (error) {
			// Show error message
			errorMessage.hidden = false;

			// Reset button
			buttonText.textContent = 'Send Message';
			submitButton.disabled = false;

			// Hide error message after 5 seconds
			setTimeout(() => {
				errorMessage.hidden = true;
			}, 5000);

			console.error('Form submission error:', error);
		}
	});

	// Smooth scroll to contact form
	const contactSection = document.getElementById('contact');
	document.querySelectorAll('[data-scroll-to-contact]').forEach((el) => {
		el.addEventListener('click', (e) => {
			if (!contactSection) return;
			e.preventDefault();
			contactSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
		});
	});
</script>
