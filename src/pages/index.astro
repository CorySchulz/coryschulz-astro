			// Under reduced motion split-text marks itself revealed and never
			// splits, so the line stays plain readable text. The attribute is
			// still written above, which keeps the code line honest.
			if (reduced.matches) return;
			if (typeof specimen.split !== 'function' || typeof specimen.reveal !== 'function') return;
