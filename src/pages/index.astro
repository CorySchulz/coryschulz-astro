<script>
	import '@magic-spells/dropdown-select';
	import '@magic-spells/split-text';
	// Registers <scrolling-content> and injects its own layered stylesheet.
	// Reduced motion is handled inside the component: the loop never starts and
	// the rows stay a scrubbable strip.
	import '@magic-spells/scrolling-content';
	import Reveal from '@magic-spells/reveal';
	import { timeline, scrollDriver } from '@magic-spells/timeline-engine';

	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

	// ---- Scroll reveals ------------------------------------------------------
	Reveal.init({ offset: 100, once: true });

	// ---- Timeline: scroll-scrubbed horizontal strip (desktop only) ----------
	const scrollEl = document.getElementById('tl-scroll') as HTMLElement | null;
	const stripEl = document.getElementById('tl-strip') as HTMLElement | null;
	const viewportEl = document.getElementById('tl-viewport') as HTMLElement | null;

	const desktop = window.matchMedia('(min-width: 768px)');

	let scrub: { destroy: () => void } | null = null;

	function buildScrub() {
		if (!scrollEl || !stripEl || !viewportEl) return;
		if (!desktop.matches) {
			scrollEl.classList.remove('tl-fits');
			return;
		}

		// Pin first, then measure the real travel distance — pinning collapses
		// the section's height, which can take the page scrollbar with it and
		// change how much room the viewport actually has.
		const canPin = !reduced.matches;
		if (canPin) scrollEl.classList.add('is-scrubbed');
		// scrollWidth is the full track including its own padding-inline, so the
		// last card clears the right edge by the same gutter the first one has.
		const travel = Math.round(stripEl.scrollWidth - viewportEl.clientWidth);

		// Wide enough that the whole strip fits: nothing to travel, so no pin
		// and no transform — the page just scrolls through. .tl-fits centres
		// the strip so it doesn't sit flush-left with dead space beside it.
		// The resize handler re-runs this in both directions, so shrinking the
		// window re-engages the scrub and widening it releases again.
		scrollEl.classList.toggle('tl-fits', travel <= 0);

		if (travel <= 0 || !canPin) {
			scrollEl.classList.remove('is-scrubbed');
			return;
		}

		// 1:1 scroll feel — the pinned viewport plus exactly the horizontal travel.
		scrollEl.style.height = `${window.innerHeight + travel}px`;

		const tl = timeline();
		tl.tween(
			'#tl-strip',
			{
				0: { transform: 'translateX(0px)' },
				100: { transform: `translateX(${-travel}px)` },
			},
			{ duration: 1000, easing: 'linear' }
		);

		const driver = scrollDriver(tl, {
			trigger: '#tl-scroll',
			start: 'top top',
			end: 'bottom bottom',
			smoothing: 90,
		});

		scrub = {
			destroy() {
				driver.destroy();
				tl.destroy();
				scrollEl.classList.remove('is-scrubbed');
				scrollEl.style.height = '';
				stripEl.style.transform = '';
			},
		};
	}

	function teardownScrub() {
		if (scrub) {
			scrub.destroy();
			scrub = null;
		}
	}

	function rebuildScrub() {
		teardownScrub();
		buildScrub();
	}

	buildScrub();

	// Only re-measure when the width actually changes. Height-only resizes
	// (mobile URL bars, devtools) would otherwise collapse the pinned region
	// and yank the reader's scroll position mid-scrub.
	let lastWidth = window.innerWidth;
	let resizeTimer: number | undefined;
	window.addEventListener('resize', () => {
		if (window.innerWidth === lastWidth) return;
		lastWidth = window.innerWidth;
		window.clearTimeout(resizeTimer);
		resizeTimer = window.setTimeout(rebuildScrub, 200);
	});

	desktop.addEventListener('change', rebuildScrub);
	reduced.addEventListener('change', rebuildScrub);

	// ---- Split Text lab ------------------------------------------------------
	// Ported from magicspells.io's SplitTextDemo. The replay contract is exact:
	// `effect` is read once inside connectedCallback while the element is
	// uninitialised, so it MUST be written before split(). split() rebuilds
	// brand-new spans (so no rAF is needed to restart the animation) and
	// reveal() then sets data-state="revealing".
	const specimen = document.getElementById('st-specimen');
	const stStage = document.getElementById('st-stage');
	const stEffects = document.getElementById('st-effects');
	const stReplay = document.getElementById('st-replay');
	const stCode = document.getElementById('st-code');

	if (specimen && stStage && stEffects && stReplay && stCode) {
		const SPLIT_MODE = 'chars';
		const markupFor = (effect) => `<split-text effect="${effect}" split="${SPLIT_MODE}">`;
		let current = 'rise';

		const play = (effect) => {
			const next = effect || current;
			specimen.setAttribute('effect', next);
			// Under reduced motion split-text marks itself revealed and never
			// splits, so the line stays plain readable text. The attribute is
			// still written above, which keeps the code line honest.
			if (reduced.matches) return;
			if (typeof specimen.split !== 'function' || typeof specimen.reveal !== 'function') return;
			specimen.split();
			specimen.reveal();
		};

		stEffects.addEventListener('click', (e) => {
			const button = (e.target as HTMLElement).closest('.st-chip') as HTMLElement | null;
			if (!button) return;
			const effect = button.dataset.effect;
			if (!effect) return;
			current = effect;
			stEffects.querySelectorAll('.st-chip').forEach((b) => {
				b.setAttribute('aria-pressed', b === button ? 'true' : 'false');
			});
			stCode.textContent = markupFor(effect);
			play(effect);
		});

		stReplay.addEventListener('click', () => play());

		// First run fires when the specimen scrolls into view, so the visitor
		// sees the reveal rather than arriving after it. trigger="manual" means
		// the element does no observing of its own.
		if (reduced.matches || typeof IntersectionObserver === 'undefined') {
			play();
		} else {
			const io = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (!entry.isIntersecting) continue;
						io.disconnect();
						play();
						break;
					}
				},
				{ threshold: 0.5 }
			);
			io.observe(stStage);
		}
	}

	// ---- Ported demos: fireworks (timeline-engine) and the constellation field
	// Both are heavy and only matter once they are near the viewport, so they
	// are code-split and mounted lazily. Both also run open-ended loops — a
	// self-rescheduling rAF and a `loop: true` timeline — that would otherwise
	// keep burning frames long after the panel has scrolled away, so the handle
	// each one returns is kept and driven from here: a second, permanent
	// observer for "is it on screen", plus the document's visibility for "is
	// anyone even looking at this tab".
	type DemoHandle = { destroy: () => void; pause?: () => void; resume?: () => void };

	const mountWhenNear = (el: Element | null, load: () => Promise<DemoHandle>) => {
		if (!el) return;

		let handle: DemoHandle | null = null;
		let onScreen = true;

		const sync = () => {
			if (!handle) return;
			if (onScreen && document.visibilityState !== 'hidden') handle.resume?.();
			else handle.pause?.();
		};

		document.addEventListener('visibilitychange', sync);

		const mount = () =>
			load()
				.then((demo) => {
					handle = demo;
					if (typeof IntersectionObserver === 'undefined') return;
					// Distinct from the loader observer above, which disconnects
					// after firing once: this one stays for the life of the page.
					const live = new IntersectionObserver(
						(entries) => {
							for (const entry of entries) onScreen = entry.isIntersecting;
							sync();
						},
						{ rootMargin: '100px' }
					);
					live.observe(el);
				})
				.catch((err) => {
					// A demo that refuses to load is a missing flourish, not a
					// broken page — say so in the console and leave the rest alone.
					console.error('demo failed to mount', err);
				});

		if (typeof IntersectionObserver === 'undefined') {
			mount();
			return;
		}
		const io = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					io.disconnect();
					mount();
					break;
				}
			},
			{ rootMargin: '200px' }
		);
		io.observe(el);
	};

	const fireworksMount = document.getElementById('fireworks-mount');
	mountWhenNear(fireworksMount, async () => {
		const { default: initFireworks } = await import('../scripts/demos/fireworks.js');
		return initFireworks(fireworksMount as HTMLElement);
	});

	// Ambient settings: sparse, slow, and no gold constellation patterns — the
	// field is background here, not the demo it was in the hero. It still pauses
	// offscreen and on tab-hide through mountWhenNear, and the module parks it
	// static under prefers-reduced-motion.
	const cfCanvas = document.getElementById('cf-canvas');
	mountWhenNear(cfCanvas, async () => {
		const { default: initConstellationField } = await import(
			'../scripts/demos/constellation-field.js'
		);
		return initConstellationField(cfCanvas as HTMLCanvasElement, {
			density: 0.4,
			driftScale: 0.55,
			maxEvents: 0,
		});
	});

	// ---- Morph engine: card flies open into a real <dialog> -------------------
	// The dialog is promoted with showModal() at the engine's `reveal` event
	// rather than at settle: the destination is still at opacity 0 there, so the
	// top-layer repaint lands on an invisible surface and it fades in already
	// modal. Being a real modal dialog is what supplies the focus trap, the
	// inert page and Escape — the library ships no a11y helpers of its own.
	const morphGrid = document.getElementById('morph-grid');
	const morphDialog = document.getElementById('morph-dialog') as HTMLDialogElement | null;
	const morphScrim = document.getElementById('morph-scrim');

	if (morphGrid && morphDialog && morphScrim) {
		const cards = JSON.parse(morphGrid.dataset.cards || '[]') as Array<{
			id: string;
			name: string;
			meta: string;
			tagline: string;
			body: string;
			install: string;
		}>;

		const field = (id: string) => document.getElementById(id) as HTMLElement;
		const closeButton = document.getElementById('morph-dialog-close');

		let engine: any = null;
		let openCard: HTMLElement | null = null;
		// 'plain' when the morph is unavailable or unwanted, so the close path
		// unwinds exactly the way the open path went.
		let mode: 'morph' | 'plain' = 'plain';

		const fill = (id: string) => {
			const card = cards.find((c) => c.id === id);
			if (!card) return;
			field('morph-dialog-tag').textContent = card.meta;
			field('morph-dialog-title').textContent = card.name;
			field('morph-dialog-tagline').textContent = card.tagline;
			field('morph-dialog-body').textContent = card.body;
			field('morph-dialog-install').textContent = `$ ${card.install}`;
		};

		const openPlainly = () => {
			morphScrim.setAttribute('visible', '');
			morphDialog.showModal();
			closeButton?.focus({ preventScroll: true });
		};

		const closePlainly = () => {
			morphScrim.removeAttribute('visible');
			if (morphDialog.open) morphDialog.close();
		};

		const open = async (card: HTMLElement) => {
			if (morphDialog.open) return;
			openCard = card;
			fill(card.dataset.id || '');

			// Reduced motion, or a library that failed to load, both land here.
			if (reduced.matches) {
				mode = 'plain';
				openPlainly();
				return;
			}

			if (!engine) {
				try {
					const { MorphEngine } = await import('@magic-spells/morph-engine');
					engine = new MorphEngine({
						attraction: 0.13,
						friction: 0.36,
						revealAt: 0.65,
						sourceRevealUntil: 0.2,
						cloneFadeUntil: 0.3,
						lockScroll: false,
						zIndex: 950,
					});

					engine.on('reveal', ({ to }: { to: Element }) => {
						if (to === morphDialog && !morphDialog.open) morphDialog.showModal();
					});
					// A reversal that swings back below the reveal point has to
					// demote the dialog the same way it was promoted.
					engine.on('unreveal', ({ to }: { to: Element }) => {
						if (to === morphDialog && morphDialog.open) morphDialog.close();
					});
					engine.on('show', () => morphScrim.setAttribute('visible', ''));
					engine.on('hide', () => morphScrim.removeAttribute('visible'));
					engine.on('stop', () => morphScrim.removeAttribute('visible'));
				} catch (err) {
					console.error('morph-engine failed to load', err);
					engine = null;
				}
			}

			if (!engine) {
				mode = 'plain';
				openPlainly();
				return;
			}

			mode = 'morph';
			// show() during 'hiding' reverses the in-flight morph rather than
			// queueing a second one.
			if (engine.state === 'idle' || engine.state === 'hiding') {
				await engine.show({ from: card, to: morphDialog, display: 'flex' });
			}
			// Focus after the settle: for most of the flight the dialog is at
			// opacity 0, and focusing something invisible is worse than waiting.
			if (morphDialog.open) closeButton?.focus({ preventScroll: true });
		};

		const close = () => {
			if (mode === 'plain' || !engine) {
				closePlainly();
				openCard?.focus({ preventScroll: true });
				openCard = null;
				return;
			}
			if (engine.state !== 'showing' && engine.state !== 'shown') return;
			// Demote first, reverse second, in the same task: the dialog drops
			// back into normal flow at the identical rect and the blob covers it
			// on that same frame, so nothing flashes between the two.
			if (morphDialog.open) morphDialog.close();
			const returning = openCard;
			openCard = null;
			engine.hide().then(() => returning?.focus({ preventScroll: true }));
		};

		const hint = document.getElementById('morph-hint');

		morphGrid.querySelectorAll<HTMLElement>('[data-morph-card]').forEach((card) => {
			card.addEventListener('click', () => {
				hint?.setAttribute('data-used', '');
				open(card);
			});
		});

		closeButton?.addEventListener('click', close);

		// Escape on the open modal: morph home rather than snapping shut.
		morphDialog.addEventListener('cancel', (event) => {
			event.preventDefault();
			close();
		});

		// Safety net for any close path we did not drive.
		morphDialog.addEventListener('close', () => {
			morphScrim.removeAttribute('visible');
			if (engine && engine.state === 'shown' && !morphDialog.open) engine.hide();
		});

		// While modal, an outside click lands on the dialog element itself.
		morphDialog.addEventListener('click', (event) => {
			if (event.target !== morphDialog) return;
			const rect = morphDialog.getBoundingClientRect();
			const e = event as MouseEvent;
			const outside =
				e.clientX < rect.left ||
				e.clientX > rect.right ||
				e.clientY < rect.top ||
				e.clientY > rect.bottom;
			if (outside) close();
		});

		// Mid-flight the dialog is not modal yet, so the page scrim takes the click.
		morphScrim.addEventListener('click', close);
	}
</script>

<script is:inline>
	// Web3Forms Contact Form Handler
	const form = document.getElementById('contact-form');
	const submitButton = document.getElementById('submit-button');
	const buttonText = document.getElementById('button-text');
	const successMessage = document.getElementById('success-message');
	const errorMessage = document.getElementById('error-message');

	form.addEventListener('submit', async (e) => {
		e.preventDefault();

		// Disable submit button and show loading state
		submitButton.disabled = true;
		buttonText.textContent = 'Sending...';

		// Hide any previous messages
		successMessage.hidden = true;
		errorMessage.hidden = true;

		// Get form data
		const formData = new FormData(form);

		try {
			// Submit to Web3Forms
			const response = await fetch('https://api.web3forms.com/submit', {
				method: 'POST',
				body: formData,
			});

			const data = await response.json();

			if (data.success) {
				// Show success message
				successMessage.hidden = false;

				// Reset form
				form.reset();

				// Reset button
				buttonText.textContent = 'Send Message';
				submitButton.disabled = false;

				// Hide success message after 5 seconds
				setTimeout(() => {
					successMessage.hidden = true;
				}, 5000);
			} else {
				throw new Error('Form submission failed');
			}
		} catch (error) {
			// Show error message
			errorMessage.hidden = false;

			// Reset button
			buttonText.textContent = 'Send Message';
			submitButton.disabled = false;

			// Hide error message after 5 seconds
			setTimeout(() => {
				errorMessage.hidden = true;
			}, 5000);

			console.error('Form submission error:', error);
		}
	});

	// Smooth scroll to contact form
	const contactSection = document.getElementById('contact');
	document.querySelectorAll('[data-scroll-to-contact]').forEach((el) => {
		el.addEventListener('click', (e) => {
			if (!contactSection) return;
			e.preventDefault();
			contactSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
		});
	});
</script>
