14.127-15.79-31.578 0-17.728 6.925-31.855 15.79-31.855';

const STAR = 'M9 1 L10.8 7.2 L17 9 L10.8 10.8 L9 17 L7.2 10.8 L1 9 L7.2 7.2 Z';

// Tools marquee. Marks come from simple-icons and are inlined here at build
// time — path data only, painted with currentColor, so a mixed set still reads
// as one monochrome system and the page ships no runtime icon fetch.
// simple-icons has no mark for OpenAI, Klaviyo or Yotpo (it carries
// "OpenAI Gym", which is a different brand), so those three render as text
// tiles rather than a brand mark drawn by hand.
const toolIcons = si as Record<string, { path: string } | undefined>;
const iconPath = (slug: string) => toolIcons['si' + slug[0].toUpperCase() + slug.slice(1)]?.path;

const tools = [
	{ name: 'JavaScript', slug: 'javascript' },
	{ name: 'React', slug: 'react' },
	{ name: 'Next.js', slug: 'nextdotjs' },
	{ name: 'Tailwind CSS', slug: 'tailwindcss' },
	{ name: 'Vue.js', slug: 'vuedotjs' },
	{ name: 'Svelte', slug: 'svelte' },
	{ name: 'Ember.js', slug: 'emberdotjs' },
	{ name: 'Node.js', slug: 'nodedotjs' },
	{ name: 'Shopify', slug: 'shopify' },
	{ name: 'Klaviyo', slug: null },
	{ name: 'Yotpo', slug: null },
	{ name: 'Vercel', slug: 'vercel' },
	{ name: 'Cloudflare', slug: 'cloudflare' },
	{ name: 'Figma', slug: 'figma' },
	{ name: 'Sketch', slug: 'sketch' },
	{ name: 'OpenAI', slug: null },
	{ name: 'Anthropic', slug: 'anthropic' },
	{ name: 'Vite', slug: 'vite' },
	{ name: 'Webpack', slug: 'webpack' },
	{ name: 'Rollup', slug: 'rollupdotjs' },
	{ name: 'Ghostty', slug: 'ghostty' },
	{ name: 'Sublime Text', slug: 'sublimetext' },
].map((tool) => ({ ...tool, path: tool.slug ? iconPath(tool.slug) : undefined }));

// Two counter-scrolling rows at slightly different speeds, so they never lock
// into step with each other.
const toolRowA = tools.slice(0, 11);
const toolRowB = tools.slice(11);

// Counted from the vendored library rather than quoted from memory:
// 2 built-in effects (carousel, fade) + 16 premium = 18; 4 bundled plugins
// (buttons, pagination, autoplay, as-nav-for) + 6 optional = 10. The size is
// the minified UMD core gzipped (25,764 bytes).
const tarotSpecs = ['25kb gzipped', '18 effects', '10 plugins'];

// Both numbers come from the puzzle repos, not from the landing copy. The size
// is the framework's own canonical benchmark (`npm run measure:size`), which
// reports total emitted JS gzipped for its two reference apps: 21.0 KB for the
// minimal hello-world, 24.0 KB for the full todos example. The component count
// is the length of puzzle-pieces' registry.json `pieces` array (95).
const puzzleSpecs = [
	'21kb gzipped',
	'Over 90 prebuilt components in Puzzle Pieces',
	'Compiler written in Go for quick compile times',
	'Router, datastore, and view animations built in',
];

// Morph Engine demo: each card flies open into the shared dialog. The copy
// lives here so the card and the dialog are filled from one source.
const morphCards = [
	{
		id: 'tarot',
		name: 'Tarot',
		meta: 'carousel',
		tagline: 'A carousel with real physics.',
		body: 'Springs, not transitions. Throw it, catch it, or scrub it by hand, and every frame lands where the physics say it should.',
		install: 'npm i @magic-spells/tarot',
	},
	{
		id: 'puzzle',
		name: 'Puzzle',
		meta: 'framework',
		tagline: 'Single-file components.',
		body: 'A front-end app framework built on .pzl components, reactive data, and a Go plus esbuild compiler that ships static HTML.',
		install: 'npm i @magic-spells/puzzle',
	},
	{
		id: 'timeline',
		name: 'Timeline Engine',
		meta: 'animation',
		tagline: 'Choreography you can scrub.',
		body: 'A timeline is an object, not a fire-and-forget animation. Seek it, play it backwards, or hand the playhead to the scroll position.',
		install: 'npm i @magic-spells/timeline-engine',
	},
	{
		id: 'split-text',
		name: 'Split Text',
		meta: 'type',
		tagline: 'Text that makes an entrance.',
		body: 'Splits a line into words, characters, or measured lines and animates each unit on a CSS-driven stagger. Eight effects, no dependencies.',
		install: 'npm i @magic-spells/split-text',
	},
];
---

<Layout title="Cory Schulz - Front-End Engineer, Tech Lead & Shopify Developer">
	<a class="skip-link" href="#experience">Skip to content</a>

	<main id="top">
		<!-- ============ HERO ============ -->
		<section class="section hero">
			<!-- Decorative and deliberately full-bleed: it sits outside the
			     container so it keeps sizing off the section, not the text column. -->
			<svg class="constellation" viewBox="0 0 1200 360" aria-hidden="true" focusable="false">
				<circle class="twinkle twinkle-a" cx="80" cy="60" r="1.6" fill="var(--gold)"></circle>
				<circle cx="220" cy="180" r="1.1" fill="var(--cream)" opacity="0.5"></circle>
				<circle class="twinkle twinkle-b" cx="360" cy="40" r="1.3" fill="var(--cream)" opacity="0.4"></circle>
				<circle cx="540" cy="120" r="1.0" fill="var(--gold)" opacity="0.6"></circle>
				<circle class="twinkle twinkle-c" cx="700" cy="30" r="1.5" fill="var(--cream)" opacity="0.45"></circle>
				<circle cx="860" cy="150" r="1.2" fill="var(--gold)" opacity="0.7"></circle>
				<circle class="twinkle twinkle-d" cx="1000" cy="70" r="1.6" fill="var(--cream)" opacity="0.4"></circle>
				<circle cx="1120" cy="200" r="1.1" fill="var(--gold)" opacity="0.6"></circle>
				<circle cx="160" cy="300" r="1.2" fill="var(--cream)" opacity="0.35"></circle>
				<circle class="twinkle twinkle-e" cx="1040" cy="310" r="1.3" fill="var(--cream)" opacity="0.4"></circle>
				</svg>

			<div class="container hero-inner">
				<p class="eyebrow hero-eyebrow">
					<span>Senior Front-End Engineer &middot; Tech Lead</span>
				</p>

				<h1 class="hero-name">
					<split-text split="chars" trigger="load" stagger="34" duration="900"
						><span class="hero-name-part">Cory</span> <span class="hero-name-part">Schulz</span></split-text
					>
				</h1>

				<p class="hero-thesis">
					<split-text
						effect="bloom"
						split="words"
						trigger="load"
						duration="1100"
						stagger="48"
						delay="420"
						>I love to design beautiful experiences and build tools that help other people create more
						amazing things.</split-text
					>
				</p>
				<div class="hero-actions">
					<a class="pill pill-gold" href="#contact" data-scroll-to-contact>Send a Message</a>
					<a
						class="pill pill-outline"
						href="https://www.linkedin.com/in/cory-schulz/"
						target="_blank"
						rel="noopener noreferrer">
						LinkedIn
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<path
								d="M7 17 L17 7 M9 7 L17 7 L17 15"
								stroke="var(--gold)"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"></path>
						</svg>
					</a>
				</div>
			</div>
		</section>

		<!-- ============ ABOUT ============ -->
		<!-- An interstitial beat between the hero and Experience: no big section
		     title, no top hairline, so it reads as a continuation of the hero
		     rather than the first headline section. -->
		<section class="section section-about" id="about">
			<div class="container about-inner reveal reveal-fade-up reveal-delay-500">
				<p class="eyebrow">A Little About Me</p>

				<p class="about-lede">
					I&rsquo;m the creator of Magic Spells, an open-source suite of web components, and Tarot, a
					carousel with real physics. I&rsquo;ve been building for the web for twenty years, and I care
					a lot about design systems. I love working in Figma as much as in code.
				</p>

				<p class="about-lede">
					I&rsquo;ve also hired and built front-end teams from the ground up. At Pura I hired and
					trained the team, then led the full rebuild of pura.com.
				</p>

				<!-- A display band of four tiles, wider than the text column above it.
				     The numerals are static at their final values — the only motion here
				     is the tiles' staggered rise, which the reveal group drives. -->
				<ul class="stat-line">
					{
						heroStats.map((s) => (
							<li class="stat reveal reveal-fade-up" data-reveal-group="stats:100">
