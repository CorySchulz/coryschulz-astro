		   because scrollWidth includes it. */
		width: 100%;
		overflow-x: auto;
		overflow-y: hidden;
		scroll-snap-type: x mandatory;
		scrollbar-width: thin;
		scrollbar-color: var(--hairline-strong) transparent;
		padding-bottom: 1rem;
	}

	.tl-strip {
		/* One source of truth for the strip's vertical metrics, so the gold
		   hairline lands on the exact centre of the star nodes. */
		--tl-media-h: 190px;
		--tl-stack-gap: 0.75rem;
		--tl-node-size: 18px;
		--tl-node-margin: 2px;

		position: relative;
		display: flex;
		gap: 3rem;
		width: max-content;
		/* The track carries the side spacing, not the viewport — that keeps the
		   viewport full-bleed while the first and last cards still clear the
		   screen edge. scrollWidth counts this padding, so the scrub travels
